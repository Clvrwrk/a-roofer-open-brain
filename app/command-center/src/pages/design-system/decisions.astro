import DsSection from "../../components/design-system/DsSection.astro";
import DsRule from "../../components/design-system/DsRule.astro";

// Every entry: decision, why, where it is recorded, when. Sources are repo paths so a
// reader can open the primary record. Entries are grouped by the question they answer.
type Row = [string, string, string, string?];

