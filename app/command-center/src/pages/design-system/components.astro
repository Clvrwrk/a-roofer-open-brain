  <DsSection id="surface" title="Work surface & section head">
    <DsSpec label="Panel with heading" code=".queue-panel > .panel-heading + body · .surface-heading for hero rows" layout="block">
      <section style="border:1px solid var(--border);border-radius:8px;background:var(--surface)">
        <div class="panel-heading"><div><p class="eyebrow">Queues</p><h2 style="margin:0;font-size:20px;color:var(--ds-heading)">Work ready for review</h2></div><div class="segmented-control"><button class="segment is-active" type="button">All</button><button class="segment" type="button">Ready</button></div></div>
        <div style="padding:14px;color:var(--text-muted);font-size:13px">Body: cards, a table or a tree. Flat white, no shadow.</div>
      </section>
    </DsSpec>
    <DsSpec label="Department hero" code=".live-department-hero > .surface-heading > (eyebrow + h2 + note)" layout="block">
      <section class="live-department-hero" style="border:1px solid var(--border);border-radius:8px;padding:18px;background:var(--surface)"><div class="surface-heading"><div><p class="eyebrow">Conductor / Auditor</p><h2 style="margin:0;font-size:20px;color:var(--ds-heading)">Every API, agent, scheduled job and data feed — one light each.</h2><p style="margin:6px 0 0;color:var(--text-secondary);font-size:13px;max-width:70ch">Lights come from the system that actually knows. Rules in docs/109.</p></div><span class="health-badge health-ready">All green</span></div></section>
