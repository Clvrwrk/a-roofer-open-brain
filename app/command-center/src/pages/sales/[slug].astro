---
import SalesPage from "../../components/sales/SalesPage.astro";
import {parseSalesRoute} from "@proexteriors/sales-workspace";
import {getRuntimeEnv} from "@lib/runtime-env";
import DepartmentDetail from "../../components/live/DepartmentDetail.astro";
import { loadDepartmentSurface } from "@lib/live-work";

const slug = Astro.params.slug ?? "pipeline";
const route=parseSalesRoute(Astro.url.pathname,Astro.url.search);
const useShared=getRuntimeEnv().CRM_SALES_WORKSPACE_ENABLED==='true' && route;
const surface=useShared?undefined:await loadDepartmentSurface("sales");
const title = slug === "pipeline" ? "Sales Pipeline" : slug === "call-priority" ? "Call Priority" : "Sales Detail";
---

{useShared ? <SalesPage route={useShared}/> : surface && <DepartmentDetail
  surface={surface}
  routePath={`/sales/${slug}`}
  routeTitle={title}
  routeDescription="Live CRM work filtered to the sales action path the human opened."
/>}
