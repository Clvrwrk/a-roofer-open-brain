---
// Executive · Cash Runway (mig 281) — the Owner's Sunday-night answer.
// Same live 13WCF board as /accounting/cash-flow, presented as headline tiles +
// the 13-week curve with the minimum-cash floor drawn on. The curve is a
// server-rendered SVG (no client charting dependency).
import AppShell from "../../layouts/AppShell.astro";
import { loadCashFlowBoard } from "@lib/cash-flow";

const board = await loadCashFlowBoard();
const money = (v: number) =>
  (v < 0 ? "(" : "") + "$" + Math.round(Math.abs(v)).toLocaleString("en-US") + (v < 0 ? ")" : "");
const moneyK = (v: number) => `$${Math.round(v / 1000).toLocaleString("en-US")}K`;
const pct = (v: number) => `${Math.round(v * 100)}%`;
const wk = (isoDate: string) => {
  const d = new Date(isoDate + "T00:00:00Z");
  return `${d.getUTCMonth() + 1}/${d.getUTCDate()}`;
};
const asOf = board.generatedAt.slice(0, 10);

// ---- SVG curve geometry -----------------------------------------------------
const W = 940;
const H = 260;
const PAD = { l: 62, r: 16, t: 16, b: 30 };
const points = board.weeks.map((w, i) => ({ i, x: 0, y: 0, v: w.endingCash, wk: w.weekStart, breach: w.belowFloor }));
const values = [board.beginningCash, ...points.map((p) => p.v), board.minCashFloor];
const vMax = Math.max(...values) * 1.08 || 1;
const vMin = Math.min(0, Math.min(...values) * 1.05);
const xAt = (i: number) => PAD.l + (i / Math.max(points.length - 1, 1)) * (W - PAD.l - PAD.r);
const yAt = (v: number) => PAD.t + (1 - (v - vMin) / (vMax - vMin)) * (H - PAD.t - PAD.b);
for (const p of points) { p.x = xAt(p.i); p.y = yAt(p.v); }
const linePath = points.map((p, idx) => `${idx === 0 ? "M" : "L"}${p.x.toFixed(1)},${p.y.toFixed(1)}`).join(" ");
const areaPath = points.length
  ? `${linePath} L${points[points.length - 1].x.toFixed(1)},${yAt(Math.max(vMin, 0)).toFixed(1)} L${points[0].x.toFixed(1)},${yAt(Math.max(vMin, 0)).toFixed(1)} Z`
  : "";
const floorY = yAt(board.minCashFloor);
const gridVals = [0.25, 0.5, 0.75, 1].map((f) => vMin + f * (vMax - vMin));
---

<AppShell title="Cash Runway" eyebrow="Executive" activePage="executive">
  <section class="cr">
    <div class="cr-head">
      <div>
        <h1>Cash Runway</h1>
        <p class="cr-note">
          13-week cash forecast (13WCF), live as of {asOf}. Dated receipts stream from the
          <a href="/accounting/friday-wip">WIP/AR board</a>; drivers are managed on the
          <a href="/accounting/cash-flow">accounting work surface</a>. Assumption-driven weeks are
          provisional until the CPA rulings land (basis_version 0).
        </p>
      </div>
      <div class="cr-actions">
        <a class="cr-btn" href="/api/accounting/cash-flow.xlsx" download>Download workbook (.xlsx)</a>
      </div>
    </div>

    {board.error && <p class="cr-error">{board.error}</p>}

    <div class="cr-tiles">
      <div class="cr-tile big"><div class="n">{money(board.beginningCash)}</div><div class="l">Cash today</div></div>
      <div class="cr-tile"><div class="n">{board.weeks.length ? board.weeks[0].weeksOfCash.toFixed(1) : "—"}</div><div class="l">Weeks of cash on hand</div></div>
      <div class="cr-tile" class:list={[{ bad: board.floorBreached }]}>
        <div class="n">{money(board.minEndingCash)}</div>
        <div class="l">13-week low{board.minEndingWeek ? ` · wk of ${wk(board.minEndingWeek)}` : ""}</div>
      </div>
      <div class="cr-tile" class:list={[{ bad: board.floorBreached }]}>
        <div class="n">{board.floorBreached ? "BELOW FLOOR" : "Above floor"}</div>
        <div class="l">Owner's minimum: {money(board.minCashFloor)}</div>
      </div>
    </div>

    <div class="cr-chart-card">
      <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="13-week ending cash curve with minimum cash floor" preserveAspectRatio="xMidYMid meet">
        {gridVals.map((v) => (
          <>
            <line x1={PAD.l} y1={yAt(v)} x2={W - PAD.r} y2={yAt(v)} stroke="#eef1f5" stroke-width="1" />
            <text x={PAD.l - 8} y={yAt(v) + 4} text-anchor="end" font-size="10.5" fill="#8a95a3">{moneyK(v)}</text>
          </>
        ))}
        <path d={areaPath} fill="#1f4e3d" opacity="0.07"></path>
        <line x1={PAD.l} y1={floorY} x2={W - PAD.r} y2={floorY} stroke="#a33b2e" stroke-width="1.5" stroke-dasharray="6 4" />
        <text x={W - PAD.r} y={floorY - 6} text-anchor="end" font-size="10.5" fill="#a33b2e">floor {moneyK(board.minCashFloor)}</text>
        <path d={linePath} fill="none" stroke="#1f4e3d" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round"></path>
        {points.map((p) => (
          <>
            <circle cx={p.x} cy={p.y} r={p.i === points.length - 1 ? 4.5 : 3} fill={p.breach ? "#a33b2e" : "#1f4e3d"} />
            <text x={p.x} y={H - 10} text-anchor="middle" font-size="10" fill="#8a95a3">{wk(p.wk)}</text>
          </>
        ))}
      </svg>
    </div>

    <div class="cr-cols">
      <div>
        <h2>Where the cash comes from · goes</h2>
        <table class="cr-table">
          <tbody>
            <tr class="sec"><td colspan="2">Receipts, 13 weeks</td></tr>
            <tr><td>Dated AR (live from WIP board)</td><td class="num live">{money(board.weeks.reduce((s, w) => s + w.datedReceipts, 0))}</td></tr>
            <tr><td>Undated AR pool (assumption spread)</td><td class="num">{money(board.weeks.reduce((s, w) => s + w.undatedReceipts, 0))}</td></tr>
            <tr><td>New billings converting</td><td class="num">{money(board.weeks.reduce((s, w) => s + w.newBillings, 0))}</td></tr>
            <tr class="sec"><td colspan="2">Disbursements, 13 weeks</td></tr>
            <tr><td>Materials · subs · commissions</td><td class="num">{money(board.weeks.reduce((s, w) => s + w.materials + w.subs + w.commissions, 0))}</td></tr>
            <tr><td>W-2 payroll + employer taxes</td><td class="num">{money(board.weeks.reduce((s, w) => s + w.payroll, 0))}</td></tr>
            <tr><td>Fixed overhead (<a href="/executive/fixed-costs">register</a>)</td><td class="num">{money(board.weeks.reduce((s, w) => s + w.fixedOverhead, 0))}</td></tr>
            <tr class="bold"><td>Net over 13 weeks</td><td class="num" class:list={[{ neg: board.weeks.reduce((s, w) => s + w.net, 0) < 0 }]}>{money(board.weeks.reduce((s, w) => s + w.net, 0))}</td></tr>
          </tbody>
        </table>
      </div>
      <div>
        <h2>Forecast confidence</h2>
        <div class="cr-conf" class:list={[{ bad: board.datedShare < 0.5 }]}>
          <div class="n">{pct(board.datedShare)}</div>
          <p>
            of AR value carries a real expected date. The other {money(board.undatedCash)} across
            {board.undatedJobs} jobs is spread by assumption — every job dated on the
            <a href="/accounting/friday-wip">WIP/AR board</a> moves real dollars into real weeks and
            raises this number. {board.undatedInsuranceCash > 0 ? `Insurance-flagged undated: ${money(board.undatedInsuranceCash)}.` : ""}
          </p>
        </div>
        {board.pastExpectedCash > 0 && (
          <p class="cr-warn">{money(board.pastExpectedCash)} of dated AR is past its expected date (folded into week 1) — chase or re-date.</p>
        )}
        <p class="cr-note">Bank balances: {board.bankAccounts.map((b) => `${b.name} ${money(b.balance)}`).join(" · ")}</p>
      </div>
    </div>
  </section>
</AppShell>

<style>
  .cr{padding:8px 4px 40px;max-width:1040px}
  .cr-head{display:flex;gap:16px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}
  .cr h1{font-size:22px;margin:0 0 8px}
  .cr h2{font-size:15px;margin:24px 0 8px}
  .cr-note{font-size:13px;color:#6b7886;line-height:1.55;margin:0;max-width:70ch}
  .cr-actions{display:flex;gap:8px}
  .cr-btn{border:1px solid #5b46d8;background:#5b46d8;color:#fff;border-radius:8px;padding:7px 11px;font-size:12.5px;font-weight:700;text-decoration:none;white-space:nowrap}
  .cr-error{color:#a33b2e;font-size:13px}
  .cr-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:16px 0}
  .cr-tile{border:1px solid #e3e8ef;border-radius:12px;background:#fff;padding:14px 16px}
  .cr-tile .n{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums}
  .cr-tile.big .n{font-size:28px}
  .cr-tile .l{font-size:11.5px;color:#6b7886;margin-top:2px}
  .cr-tile.bad .n{color:#a33b2e}
  .cr-chart-card{border:1px solid #e3e8ef;border-radius:12px;background:#fff;padding:10px 6px 2px}
  .cr-chart-card svg{width:100%;height:auto;display:block}
  .cr-cols{display:grid;grid-template-columns:repeat(auto-fit,minmax(360px,1fr));gap:24px;align-items:start}
  .cr-table{width:100%;border-collapse:collapse;font-size:13px;background:#fff;border:1px solid #e3e8ef;border-radius:12px}
  .cr-table td{padding:7px 12px;border-bottom:1px solid #eef1f5}
  .cr-table td.num{text-align:right;font-variant-numeric:tabular-nums}
  .cr-table td.live{color:#1f4e3d;font-weight:600}
  .cr-table td.neg{color:#a33b2e}
  .cr-table tr.sec td{background:#f7f8fa;font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#425466}
  .cr-table tr.bold td{font-weight:700}
  .cr-conf{border:1px solid #e3e8ef;border-radius:12px;background:#fff;padding:14px 16px}
  .cr-conf .n{font-size:26px;font-weight:700;color:#1f4e3d}
  .cr-conf.bad .n{color:#b4560f}
  .cr-conf p{font-size:12.5px;color:#425466;line-height:1.55;margin:6px 0 0}
  .cr-warn{font-size:12.5px;color:#b4560f;margin:10px 0 0}
</style>
