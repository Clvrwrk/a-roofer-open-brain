---
// Executive · Fixed Costs (mig 281) — the Owner's overhead picture.
// Register classifications are basis_version 0 (PROVISIONAL — R1–R11 rulings
// pending the CPA strategy meeting) and banner as such. Actuals come from
// mv_overhead_account_month (nightly). Allocation preview uses billed share of
// the current WIP population — an explicitly labeled placeholder until the
// Jan 1 GL conversion delivers real location P&L.
import AppShell from "../../layouts/AppShell.astro";
import { loadFixedCostBoard } from "@lib/fixed-costs";

const board = await loadFixedCostBoard();
const money = (v: number) =>
  (v < 0 ? "(" : "") + "$" + Math.round(Math.abs(v)).toLocaleString("en-US") + (v < 0 ? ")" : "");
const pct1 = (v: number) => `${(v * 100).toFixed(1)}%`;
const asOf = board.generatedAt.slice(0, 10);
const lastMonthLabel = board.lastFullMonth
  ? new Date(board.lastFullMonth + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })
  : "last month";
const behaviorLabel: Record<string, string> = { fixed: "Fixed", step_fixed: "Step-fixed", variable: "Variable", mixed: "Mixed" };
---

<AppShell title="Fixed Costs" eyebrow="Executive" activePage="executive">
  <section class="fc">
    <div class="fc-head">
      <div>
        <h1>Fixed Costs &amp; Overhead</h1>
        <p class="fc-note">
          Every overhead account, classified and budgeted from the Fixed-Cost Register. Actuals refresh
          nightly from the QuickBooks mirror (read-only). As of {asOf}.
        </p>
      </div>
      <div class="fc-actions">
        <a class="fc-btn" href="/api/executive/fixed-costs.xlsx" download>Download workbook (.xlsx)</a>
        <a class="fc-btn fc-secondary" href="/executive/cash-runway">Cash Runway</a>
      </div>
    </div>

    {board.provisional && (
      <div class="fc-banner">
        <b>Provisional — basis_version {board.basisVersion}.</b> {board.rulingsOpen} classification rulings
        (R1–R11) are pending the CPA strategy meeting. Numbers are real; the fixed/variable and
        pool assignments are draft until the rulings land.
      </div>
    )}
    {board.error && <p class="fc-error">{board.error}</p>}

    <div class="fc-tiles">
      <div class="fc-tile big"><div class="n">{money(board.monthlyNut)}</div><div class="l">Monthly nut (budget)</div></div>
      <div class="fc-tile"><div class="n">{money(board.ttmOverhead)}</div><div class="l">TTM overhead</div></div>
      <div class="fc-tile"><div class="n">{pct1(board.overheadPctOfRevenue)}</div><div class="l">Of {money(board.ttmRevenue)} TTM revenue</div></div>
      <div class="fc-tile"><div class="n">{pct1(board.fixedShare)}</div><div class="l">Fixed + step-fixed share</div></div>
    </div>

    <h2>Cost pools <span class="fc-sub">budget vs. actual · {lastMonthLabel} = last full month</span></h2>
    <div class="fc-card">
      <table class="fc-table">
        <thead>
          <tr><th>Pool</th><th class="num">Monthly budget</th><th class="num">{lastMonthLabel} actual</th><th class="num">3-mo avg</th><th class="num">Δ vs budget</th><th class="num">Accounts</th><th class="num">Rulings</th></tr>
        </thead>
        <tbody>
          {board.pools.map((p) => {
            const delta = p.avg3moActual - p.monthlyBudget;
            return (
              <tr>
                <td>{p.label}</td>
                <td class="num">{money(p.monthlyBudget)}</td>
                <td class="num">{money(p.lastMonthActual)}</td>
                <td class="num">{money(p.avg3moActual)}</td>
                <td class="num" class:list={[{ over: delta > 0 && Math.abs(delta) > p.monthlyBudget * 0.1 }]}>{money(delta)}</td>
                <td class="num">{p.accounts}</td>
                <td class="num">{p.rulingsOpen > 0 ? <span class="fc-ruling">{p.rulingsOpen}</span> : ""}</td>
              </tr>
            );
          })}
          <tr class="bold">
            <td>Total</td>
            <td class="num">{money(board.pools.reduce((s, p) => s + p.monthlyBudget, 0))}</td>
            <td class="num">{money(board.pools.reduce((s, p) => s + p.lastMonthActual, 0))}</td>
            <td class="num">{money(board.pools.reduce((s, p) => s + p.avg3moActual, 0))}</td>
            <td class="num">{money(board.pools.reduce((s, p) => s + p.avg3moActual - p.monthlyBudget, 0))}</td>
            <td class="num">{board.rows.length}</td>
            <td class="num">{board.rulingsOpen}</td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="fc-cols">
      <div class="fc-wide">
        <h2>Register <span class="fc-sub">{board.rows.length} accounts · ⚑ = ruling pending</span></h2>
        <div class="fc-pane" id="register-pane" data-pane-key="fc-register">
          <table class="fc-table">
            <thead>
              <tr><th>Account</th><th>Behavior</th><th>Attribution</th><th class="num">Budget / mo</th><th class="num">3-mo avg</th><th></th></tr>
            </thead>
            <tbody>
              {board.rows
                .slice()
                .sort((a, b) => b.monthlyBudget - a.monthlyBudget)
                .map((r) => (
                  <tr>
                    <td title={r.notes ?? ""}>{r.accountFqn}</td>
                    <td>{behaviorLabel[r.costBehavior] ?? r.costBehavior}</td>
                    <td>{r.attribution === "office_direct" ? "Office-direct" : r.attribution === "inferred" ? `Inferred — ${r.attributionRule ?? ""}` : "Corporate"}</td>
                    <td class="num">{money(r.monthlyBudget)}</td>
                    <td class="num">{money(r.avg3moActual)}</td>
                    <td>{r.needsRuling ? <span class="fc-ruling" title={r.notes ?? ""}>⚑ {r.rulingRef}</span> : ""}</td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
        <button class="fc-showall" id="register-toggle" type="button">Show all {board.rows.length} …</button>
      </div>

      <div>
        <h2>Allocation preview <span class="fc-sub">corporate overhead by office</span></h2>
        <div class="fc-card">
          <table class="fc-table">
            <thead><tr><th>Location</th><th class="num">Billed share</th><th class="num">Allocated / mo</th></tr></thead>
            <tbody>
              {board.officeAllocations.map((a) => (
                <tr><td>{a.location}</td><td class="num">{pct1(a.billedShare)}</td><td class="num">{money(a.corporateAllocated)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="fc-hint">
          Placeholder basis: billed share of the current WIP/AR population. Real by-office P&amp;L
          arrives with the Jan 1 GL conversion (QBO Locations + Classes, tag-at-entry) — this
          preview shows the mechanics the Owner will get, honestly labeled.
        </p>
      </div>
    </div>
  </section>
</AppShell>

<script>
  // Long-list disclosure (standards/design/v1 §Long-list): the register pane
  // opens at 10 rows; expanding keeps the SAME measured height and scrolls
  // internally. Reveal state persists in localStorage.
  const pane = document.getElementById("register-pane");
  const toggle = document.getElementById("register-toggle");
  if (pane && toggle) {
    const rows = pane.querySelectorAll("tbody tr");
    const head = pane.querySelector("thead");
    if (rows.length > 10) {
      const headH = head instanceof HTMLElement ? head.offsetHeight : 0;
      const row10 = rows[9] as HTMLElement;
      const paneH = row10.offsetTop + row10.offsetHeight;
      pane.style.height = `${paneH + headH}px`;
      const key = pane.dataset.paneKey ?? "fc-pane";
      const apply = (expanded: boolean) => {
        pane.style.overflowY = expanded ? "auto" : "hidden";
        toggle.textContent = expanded ? "Show first 10" : `Show all ${rows.length} …`;
        try { localStorage.setItem(key, expanded ? "1" : "0"); } catch { /* private mode */ }
      };
      let expanded = false;
      try { expanded = localStorage.getItem(key) === "1"; } catch { /* private mode */ }
      apply(expanded);
      toggle.addEventListener("click", () => { expanded = !expanded; apply(expanded); if (!expanded) pane.scrollTop = 0; });
    } else {
      toggle.style.display = "none";
    }
  }
</script>

<style>
  .fc{padding:8px 4px 40px;max-width:1120px}
  .fc-head{display:flex;gap:16px;align-items:flex-start;justify-content:space-between;flex-wrap:wrap}
  .fc h1{font-size:22px;margin:0 0 8px}
  .fc h2{font-size:15px;margin:26px 0 8px}
  .fc-sub{color:#6b7886;font-size:12px;font-weight:400;margin-left:8px}
  .fc-note{font-size:13px;color:#6b7886;line-height:1.55;margin:0;max-width:70ch}
  .fc-actions{display:flex;gap:8px;flex-wrap:wrap}
  .fc-btn{border:1px solid #5b46d8;background:#5b46d8;color:#fff;border-radius:8px;padding:7px 11px;font-size:12.5px;font-weight:700;text-decoration:none;white-space:nowrap}
  .fc-btn.fc-secondary{background:transparent;color:#5b46d8}
  .fc-banner{margin:14px 0 0;border:1px solid #ecc9a8;border-left:4px solid #b4560f;background:#fdf3e7;border-radius:8px;padding:10px 14px;font-size:13px;color:#7a4a1f;line-height:1.5}
  .fc-error{color:#a33b2e;font-size:13px}
  .fc-tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px;margin:16px 0 4px}
  .fc-tile{border:1px solid #e3e8ef;border-radius:12px;background:#fff;padding:14px 16px}
  .fc-tile .n{font-size:24px;font-weight:700;font-variant-numeric:tabular-nums}
  .fc-tile.big .n{font-size:28px}
  .fc-tile .l{font-size:11.5px;color:#6b7886;margin-top:2px}
  .fc-card{border:1px solid #e3e8ef;border-radius:12px;background:#fff;overflow-x:auto}
  .fc-pane{border:1px solid #e3e8ef;border-radius:12px;background:#fff;overflow-x:auto;overflow-y:hidden}
  .fc-table{width:100%;border-collapse:collapse;font-size:12.5px;min-width:520px}
  .fc-table th,.fc-table td{padding:6px 10px;border-bottom:1px solid #eef1f5;text-align:left;white-space:nowrap}
  .fc-table td:first-child{white-space:normal}
  .fc-table thead th{background:#f7f8fa;font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:#6b7886;position:sticky;top:0}
  .fc-table th.num,.fc-table td.num{text-align:right;font-variant-numeric:tabular-nums}
  .fc-table td.over{color:#a33b2e;font-weight:600}
  .fc-table tr.bold td{font-weight:700;border-top:2px solid #1f4e3d}
  .fc-ruling{color:#b4560f;font-weight:700;font-size:11.5px}
  .fc-cols{display:grid;grid-template-columns:minmax(420px,3fr) minmax(280px,2fr);gap:24px;align-items:start}
  @media (max-width: 900px){ .fc-cols{grid-template-columns:1fr} }
  .fc-showall{margin-top:8px;border:1px solid #d6dce4;background:#fff;border-radius:8px;padding:6px 10px;font-size:12px;cursor:pointer}
  .fc-hint{font-size:11.5px;color:#6b7886;line-height:1.5;margin:8px 0 0}
</style>
