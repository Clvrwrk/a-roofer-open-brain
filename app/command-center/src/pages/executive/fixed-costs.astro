---
// Executive · Fixed Costs (mig 281) — the Owner's overhead picture, in the
// WIP/AR design language (PEC-234): full-bleed `.cfx`, KPI pills, group
// panels, zebra tables, shared cc.theme, long-list disclosure on the register.
//
// Register classifications are basis_version 0 (PROVISIONAL — R1–R11 rulings
// pending the CPA strategy meeting) and banner as such. Actuals refresh
// nightly from the QuickBooks mirror (read-only).
import AppShell from "../../layouts/AppShell.astro";
import { loadFixedCostBoard } from "@lib/fixed-costs";
import "../../styles/cash-surface.css";

const board = await loadFixedCostBoard();
const money = (v: number) =>
  (v < 0 ? "(" : "") + "$" + Math.round(Math.abs(v)).toLocaleString("en-US") + (v < 0 ? ")" : "");
const pct1 = (v: number) => `${(v * 100).toFixed(1)}%`;
const asOf = board.generatedAt.slice(0, 10);
const lastMonthLabel = board.lastFullMonth
  ? new Date(board.lastFullMonth + "T00:00:00Z").toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" })
  : "last month";
const behaviorLabel: Record<string, string> = { fixed: "Fixed", step_fixed: "Step-fixed", variable: "Variable", mixed: "Mixed" };
---

<AppShell title="Fixed Costs" eyebrow="Executive" activePage="executive">
  <section class="cfx" id="cfx" data-theme="light" data-pref="system">
    <div class="cfx-toolbar">
      <h2 class="cfx-title">Fixed Costs &amp; Overhead</h2>
      <span class="cfx-sub">every overhead account, classified and budgeted · actuals nightly from the QBO mirror (read-only)</span>
      <span class="cfx-spacer"></span>
      <a class="cfx-btn" href="/executive/cash-runway">Cash Runway</a>
      <a class="cfx-btn cfx-btn-primary" href="/api/executive/fixed-costs.xlsx" download title="PE_FixedCosts_asof-date.xlsx — Pools / Register / Allocation Preview">Download workbook</a>
      <span class="cfx-count">as of {asOf}</span>
      <div class="cfx-theme" role="group" aria-label="Theme">
        <button type="button" data-set-theme="system" class="is-active">System</button>
        <button type="button" data-set-theme="light">Light</button>
        <button type="button" data-set-theme="dark">Dark</button>
      </div>
    </div>

    {board.provisional && (
      <p class="cfx-banner">
        <b>Provisional — basis_version {board.basisVersion}.</b> {board.rulingsOpen} accounts are flagged
        across rulings R1–R11, pending the CPA strategy meeting. The dollars are real; the fixed/variable
        and pool assignments are draft until the rulings land.
      </p>
    )}
    {board.error && <p class="cfx-error">{board.error}</p>}

    <div class="cfx-kpis">
      <div class="cfx-kpi"><span class="cfx-kpi-lab">Monthly nut (budget)</span><span class="cfx-kpi-val">{money(board.monthlyNut)}</span><span class="cfx-kpi-sub">what arrives whether or not a square sells</span></div>
      <div class="cfx-kpi"><span class="cfx-kpi-lab">TTM overhead</span><span class="cfx-kpi-val">{money(board.ttmOverhead)}</span><span class="cfx-kpi-sub">trailing 12 months, all pools</span></div>
      <div class="cfx-kpi"><span class="cfx-kpi-lab">Overhead % of revenue</span><span class="cfx-kpi-val">{pct1(board.overheadPctOfRevenue)}</span><span class="cfx-kpi-sub">of {money(board.ttmRevenue)} TTM revenue</span></div>
      <div class="cfx-kpi"><span class="cfx-kpi-lab">Fixed + step-fixed share</span><span class="cfx-kpi-val">{pct1(board.fixedShare)}</span><span class="cfx-kpi-sub">of overhead — the committed portion</span></div>
      <div class="cfx-kpi" class:list={[{ "cfx-kpi-warn": board.rulingsOpen > 0 }]}><span class="cfx-kpi-lab">Accounts awaiting ruling</span><span class="cfx-kpi-val">{board.rulingsOpen}</span><span class="cfx-kpi-sub">across R1–R11, decided at the CPA meeting</span></div>
    </div>

    <div class="cfx-group">
      <div class="cfx-group-head">
        <span class="cfx-group-name">Cost pools</span>
        <span class="cfx-group-count">budget vs. actual · {lastMonthLabel} = last full month</span>
      </div>
      <div class="cfx-tablewrap">
        <table class="cfx-table">
          <thead>
            <tr><th>Pool</th><th class="num">Monthly budget</th><th class="num">{lastMonthLabel} actual</th><th class="num">3-mo avg</th><th class="num">Δ vs budget</th><th class="num">Accounts</th><th class="num">Rulings</th></tr>
          </thead>
          <tbody>
            {board.pools.map((p) => {
              const delta = p.avg3moActual - p.monthlyBudget;
              return (
                <tr>
                  <td>{p.label}</td>
                  <td class="num">{money(p.monthlyBudget)}</td>
                  <td class="num">{money(p.lastMonthActual)}</td>
                  <td class="num">{money(p.avg3moActual)}</td>
                  <td class="num" class:list={[{ "cfx-neg": delta > 0 && Math.abs(delta) > p.monthlyBudget * 0.1 }]}>{money(delta)}</td>
                  <td class="num">{p.accounts}</td>
                  <td class="num">{p.rulingsOpen > 0 ? <span class="cfx-warn-note" style="font-weight:700">⚑ {p.rulingsOpen}</span> : ""}</td>
                </tr>
              );
            })}
            <tr class="cfx-endrow">
              <td>Total</td>
              <td class="num">{money(board.pools.reduce((s, p) => s + p.monthlyBudget, 0))}</td>
              <td class="num">{money(board.pools.reduce((s, p) => s + p.lastMonthActual, 0))}</td>
              <td class="num">{money(board.pools.reduce((s, p) => s + p.avg3moActual, 0))}</td>
              <td class="num">{money(board.pools.reduce((s, p) => s + p.avg3moActual - p.monthlyBudget, 0))}</td>
              <td class="num">{board.rows.length}</td>
              <td class="num">{board.rulingsOpen}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <div class="cfx-cols">
      <div class="cfx-group">
        <div class="cfx-group-head">
          <span class="cfx-group-name">Register</span>
          <span class="cfx-group-count">{board.rows.length} accounts · ⚑ = ruling pending</span>
        </div>
        <div class="cfx-pane" id="register-pane" data-pane-key="fc-register">
          <table class="cfx-table">
            <thead>
              <tr><th>Account</th><th>Behavior</th><th>Attribution</th><th class="num">Budget / mo</th><th class="num">3-mo avg</th><th></th></tr>
            </thead>
            <tbody>
              {board.rows
                .slice()
                .sort((a, b) => b.monthlyBudget - a.monthlyBudget)
                .map((r) => (
                  <tr>
                    <td title={r.notes ?? ""} style="max-width:280px;overflow:hidden;text-overflow:ellipsis">{r.accountFqn}</td>
                    <td>{behaviorLabel[r.costBehavior] ?? r.costBehavior}</td>
                    <td>{r.attribution === "office_direct" ? "Office-direct" : r.attribution === "inferred" ? `Inferred — ${r.attributionRule ?? ""}` : "Corporate"}</td>
                    <td class="num">{money(r.monthlyBudget)}</td>
                    <td class="num">{money(r.avg3moActual)}</td>
                    <td>{r.needsRuling ? <span class="cfx-warn-note" style="font-weight:700" title={r.notes ?? ""}>⚑ {r.rulingRef}</span> : ""}</td>
                  </tr>
                ))}
            </tbody>
          </table>
        </div>
        <button class="cfx-showmore" id="register-toggle" type="button">Show all {board.rows.length} …</button>
      </div>

      <div class="cfx-group">
        <div class="cfx-group-head">
          <span class="cfx-group-name">Allocation preview — corporate overhead by office</span>
          <span class="cfx-group-money">placeholder basis</span>
        </div>
        <div class="cfx-tablewrap">
          <table class="cfx-table">
            <thead><tr><th>Location</th><th class="num">Billed share</th><th class="num">Allocated / mo</th></tr></thead>
            <tbody>
              {board.officeAllocations.map((a) => (
                <tr><td>{a.location}</td><td class="num">{pct1(a.billedShare)}</td><td class="num">{money(a.corporateAllocated)}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="cfx-note" style="padding: 8px 14px 12px">
          Corporate-attributed budget spread by each office's billed share of the current WIP/AR
          population. Real by-office P&amp;L arrives with the Jan 1 GL conversion (QBO Locations +
          Classes, tag-at-entry) — this preview shows the mechanics, honestly labeled.
        </p>
      </div>
    </div>
  </section>
</AppShell>

<script>
  import { initThemePref } from "../../scripts/theme-pref";
  initThemePref(document.getElementById("cfx")!, ".cfx-theme button");

  // Long-list disclosure (PEC-234 rule): 10 rows, same measured height
  // expanded, internal scroll, persisted state.
  const pane = document.getElementById("register-pane");
  const toggle = document.getElementById("register-toggle");
  if (pane && toggle) {
    const rows = pane.querySelectorAll("tbody tr");
    const head = pane.querySelector("thead");
    if (rows.length > 10) {
      const headH = head instanceof HTMLElement ? head.offsetHeight : 0;
      const row10 = rows[9] as HTMLElement;
      const paneH = row10.offsetTop + row10.offsetHeight;
      pane.style.height = `${paneH + headH}px`;
      const key = pane.dataset.paneKey ?? "cfx-pane";
      const apply = (expanded: boolean) => {
        pane.style.overflowY = expanded ? "auto" : "hidden";
        toggle.textContent = expanded ? "Show first 10" : `Show all ${rows.length} …`;
        try { localStorage.setItem(key, expanded ? "1" : "0"); } catch { /* private mode */ }
      };
      let expanded = false;
      try { expanded = localStorage.getItem(key) === "1"; } catch { /* private mode */ }
      apply(expanded);
      toggle.addEventListener("click", () => { expanded = !expanded; apply(expanded); if (!expanded) pane.scrollTop = 0; });
    } else {
      toggle.style.display = "none";
    }
  }
</script>
