---
// Weekly credit memo request view — Invoice Audit v2 R2 (docs/82, Chris's decisions
// 2026-08-05): the repurposed "Credit Memo Requested" KPI card lands here. Renders the
// vendor-specific HTML request email(s) (approved invoices only; drafts listed but
// excluded from the email) with downloads for the reconciliation spreadsheet + tracker.
import AppShell from "../../../layouts/AppShell.astro";
import { cmVendorBySlug, cmVendorLabel } from "@lib/cm-vendor-roster";
import { acculynxJobHref, loadCmRequestHeaders, type CmRequestHeader } from "@lib/cm-request-header";
import { createServerSupabaseClient } from "@lib/supabase.server";

// Multi-vendor pill (docs/88): ?vendor=<slug> scopes this page (and its downloads)
// to one vendor; without it the page renders every vendor's email as before.
const vendorParam = cmVendorBySlug(Astro.url.searchParams.get("vendor"))?.slug ?? null;

interface CmLine {
  id: number; invoice_number: string; item_description: string; quantity: number; invoiced_price: number;
  office_price: number; variance_ext: number; office_name: string; agreement_number: string | null;
  agreement_effective: string | null; agreement_expiry: string | null; match_method: string; paexp_tag: string | null;
  run_label: string; created_at: string; reviewed_by: string | null; reviewed_at: string | null;
}

const { client } = createServerSupabaseClient();
let requests: { invoice_number: string; status: string; expected_credit: number; vendor: string; invoice_date?: string }[] = [];
const linesByInvoice = new Map<string, CmLine[]>();
// PE office / vendor / vendor branch / job / invoice date for each claim header.
let headers = new Map<string, CmRequestHeader>();
interface CmReceipt {
  cm_invoice_number: string; cm_total: number; cm_invoice_date: string | null;
  match_state: string; original_invoice_number: string | null; expected_credit: number | null;
}
let pendingReceipts: CmReceipt[] = [];
if (client) {
  let receiptQuery = client
    .from("credit_memo_receipts")
    .select("cm_invoice_number, cm_total, cm_invoice_date, match_state, original_invoice_number, expected_credit")
    .eq("review_status", "pending");
  if (vendorParam) receiptQuery = receiptQuery.eq("vendor_slug", vendorParam);
  const { data: receiptRows } = await receiptQuery.order("created_at", { ascending: false }).limit(200);
  pendingReceipts = (receiptRows ?? []) as CmReceipt[];
  let reqQuery = client
    .from("credit_memo_requests")
    .select("invoice_number, vendor_slug, status, expected_credit, packet")
    .eq("request_kind", "requested")
    .in("status", ["draft", "approved"]);
  if (vendorParam) reqQuery = reqQuery.eq("vendor_slug", vendorParam);
  const { data: reqRows } = await reqQuery.order("invoice_number").limit(1000);
  requests = (reqRows ?? []).map((r) => ({
    invoice_number: r.invoice_number,
    status: r.status,
    expected_credit: Number(r.expected_credit ?? 0),
    // vendor_slug is the silo key (docs/87); packet.vendor is only a legacy fallback.
    vendor: cmVendorLabel((r as any).vendor_slug) ?? (((r.packet as Record<string, unknown> | null)?.vendor as string) ?? "ABC Supply"),
  }));
  const invoiceNumbers = requests.map((r) => r.invoice_number);
  if (invoiceNumbers.length) {
    let lineQuery = client
      .from("invoice_line_reaudit")
      .select("id, run_label, invoice_number, item_description, quantity, invoiced_price, office_name, office_price, variance_ext, agreement_number, agreement_effective, agreement_expiry, match_method, paexp_tag, created_at, reviewed_by, reviewed_at")
      .in("invoice_number", invoiceNumbers)
      .eq("classification", "discrepancy");
    // Silo (docs/87): a colliding invoice number must not pull another vendor's lines.
    if (vendorParam) lineQuery = lineQuery.eq("vendor_slug", vendorParam);
    const { data: lineRows } = await lineQuery
      .order("created_at", { ascending: false })
      .limit(2000);
    const latestRun = new Map<string, string>();
    for (const l of (lineRows ?? []) as CmLine[]) {
      if (!latestRun.has(l.invoice_number)) latestRun.set(l.invoice_number, l.run_label);
    }
    for (const l of (lineRows ?? []) as CmLine[]) {
      if (latestRun.get(l.invoice_number) !== l.run_label) continue;
      if (Number(l.variance_ext ?? 0) < 0.05) continue;
      (linesByInvoice.get(l.invoice_number) ?? linesByInvoice.set(l.invoice_number, []).get(l.invoice_number)!).push(l);
    }
    headers = await loadCmRequestHeaders(client, invoiceNumbers);
  }
}

const vendors = [...new Set(requests.map((r) => r.vendor))].sort();
const money = (n: number) => "$" + Number(n).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const approvedFor = (vendor: string) => requests.filter((r) => r.vendor === vendor && r.status === "approved");
const draftFor = (vendor: string) => requests.filter((r) => r.vendor === vendor && r.status === "draft");
const vendorTotal = (vendor: string) => approvedFor(vendor).reduce((s, r) => s + r.expected_credit, 0);
const vendorLineCount = (vendor: string) => approvedFor(vendor).reduce((s, r) => s + (linesByInvoice.get(r.invoice_number)?.length ?? 0), 0);

// ── invoice-audit-style nesting (Chris 2026-09-01): every CM work surface
// groups PE Office → Vendor → Vendor Branch → line detail, exactly like
// /accounting/invoice-audit. Sent CM carries the same tree — keep in sync.
// The per-vendor copyable EMAIL keeps vendor-wide scope in the collapsed
// preview below the tree (the email is a per-vendor artifact, not per office).
type Req = (typeof requests)[number];
interface CmTreeBranch { branch: string; invoices: Req[]; }
interface CmTreeVendor { vendor: string; branches: CmTreeBranch[]; invoices: Req[]; }
interface CmTreeOffice { office: string; vendors: CmTreeVendor[]; invoices: Req[]; }
const buildCmTree = (rows: Req[]): CmTreeOffice[] => {
  const om = new Map<string, Map<string, Map<string, Req[]>>>();
  for (const r of rows) {
    const h = headers.get(r.invoice_number);
    const office = h?.office || "Office not resolved";
    const branch = h?.branchName || h?.branchNumber
      ? (h?.branchNumber ? (h?.branchName ? h.branchName + " (" + h.branchNumber + ")" : String(h.branchNumber)) : String(h?.branchName))
      : "Branch not resolved";
    const vm = om.get(office) ?? new Map(); om.set(office, vm);
    const bm = vm.get(r.vendor) ?? new Map(); vm.set(r.vendor, bm);
    const list = bm.get(branch) ?? []; bm.set(branch, list);
    list.push(r);
  }
  return [...om.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([office, vm]) => {
    const vendorGroups = [...vm.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([vendor, bm]) => {
      const branches = [...bm.entries()].sort((a, b) => a[0].localeCompare(b[0])).map(([branch, invoices]) => ({ branch, invoices }));
      return { vendor, branches, invoices: branches.flatMap((b) => b.invoices) };
    });
    return { office, vendors: vendorGroups, invoices: vendorGroups.flatMap((v) => v.invoices) };
  });
};
const approvedOf = (rows: Req[]) => rows.filter((r) => r.status === "approved");
const draftOf = (rows: Req[]) => rows.filter((r) => r.status === "draft");
const lineCountOf = (rows: Req[]) => rows.reduce((s, r) => s + (linesByInvoice.get(r.invoice_number)?.length ?? 0), 0);
const totalOf = (rows: Req[]) => rows.reduce((s, r) => s + r.expected_credit, 0);
const tree = buildCmTree(requests);
// PE Office · Vendor · Vendor branch (id) · Job# · Invoice date — the context a human
// (or the vendor) needs before acting on a claim. Missing pieces are named, not blanked.
// PE Office · Vendor · Vendor branch (id) · Job# · Invoice date. Split so the job can be
// a real AccuLynx link; missing pieces are NAMED, never blanked, so a gap is visible.
const headerParts = (invoiceNumber: string, vendor: string) => {
  const h = headers.get(invoiceNumber);
  const branch = h?.branchName || h?.branchNumber
    ? (h.branchNumber ? `${h.branchName} (${h.branchNumber})` : h.branchName)
    : "branch not resolved";
  return {
    lead: [h?.office || "office not resolved", vendor, branch].join(" · "),
    jobNumber: h?.jobNumber ?? "",
    jobHref: acculynxJobHref(h?.acculynxJobId ?? null),
    clientName: h?.clientName ?? "",
    invoiced: h?.invoiceDate ? `Invoiced ${h.invoiceDate}` : "invoice date unknown",
  };
};
// Per-draft review state, precomputed so the tree template stays
// expression-bodied (the Astro compiler rejects block arrows nested deep).
const draftMeta = new Map(requests.filter((r) => r.status === "draft").map((r) => {
  const claimLines = linesByInvoice.get(r.invoice_number) ?? [];
  const reviewed = claimLines.filter((l) => l.reviewed_at).length;
  return [r.invoice_number, { claimLines, reviewed, allReviewed: claimLines.length > 0 && reviewed === claimLines.length }];
}));
const reasonFor = (l: CmLine) => {
  const pct = l.office_price ? (((Number(l.invoiced_price) - Number(l.office_price)) / Number(l.office_price)) * 100).toFixed(1) : "?";
  // Every claim names the agreement it challenges the billed amount against
  // (Chris 2026-08-05). When the agreement metadata is missing, say so honestly
  // instead of rendering "null ... (eff. ?)".
  const agreement = l.agreement_number
    ? `agreement ${l.agreement_number}${l.agreement_effective ? ` (eff. ${l.agreement_effective}${l.agreement_expiry ? ` to ${l.agreement_expiry}` : ""})` : ""}`
    : "negotiated price list on file";
  const office = l.office_name ? `the ${l.office_name} office ` : "our ";
  let r = `Billed ${money(Number(l.invoiced_price))} against ${money(Number(l.office_price))} on ${office}${agreement} - overcharge ${pct}%.`;
  if (l.paexp_tag) r += ` The agreement had lapsed without a successor and remains in force (${l.paexp_tag}).`;
  return r;
};
---

<AppShell title="Weekly Credit Memo Request" eyebrow="Accounting" activePage="accounting">
  <section class="cmw">
    <div class="cmw-bar">
      <h1>Weekly Credit Memo Request{vendorParam ? ` — ${cmVendorLabel(vendorParam)}` : ""}</h1>
      <div class="cmw-actions">
        <a class="cmw-btn" href={`/api/credit-memos/weekly-csv?kind=detail${vendorParam ? `&vendor=${encodeURIComponent(vendorParam)}` : ""}`} download>⬇ Reconciliation spreadsheet</a>
        <a class="cmw-btn" href={`/api/credit-memos/weekly-csv?kind=tracker${vendorParam ? `&vendor=${encodeURIComponent(vendorParam)}` : ""}`} download>⬇ Tracker CSV</a>
        {vendorParam && <a class="cmw-btn cmw-secondary" href="/accounting/credit-memos/weekly">All vendors</a>}
        <a class="cmw-btn cmw-secondary" href="/accounting/invoice-audit">← Invoice Audit</a>
      </div>
    </div>
    <p class="cmw-note">Vendor-specific request emails build from <b>approved</b> invoices only (docs/81 decision 8). Approve or un-approve invoices from the Invoice Audit dashboard. Drafts below are awaiting approval and are excluded from the email.</p>

    {pendingReceipts.length > 0 && (
      <div class="cmw-vendor cmw-receipts">
        <p class="cmw-drafts-title">Credit memos received — review required ({pendingReceipts.length}). A vendor credit arrived that does not exactly match an open request: Approve accepts it as satisfying the closest request; Re-request keeps our request in the weekly email.</p>
        <table>
          <thead><tr><th>Credit memo</th><th class="num">Amount</th><th>Date</th><th>Match state</th><th>Closest request</th><th class="num">Expected</th><th></th></tr></thead>
          <tbody>
            {pendingReceipts.map((r) => (
              <tr data-receipt={r.cm_invoice_number}>
                <td>{r.cm_invoice_number}</td>
                <td class="num">{money(Number(r.cm_total))}</td>
                <td>{r.cm_invoice_date ?? ""}</td>
                <td>{r.match_state.replace(/_/g, " ")}</td>
                <td>{r.original_invoice_number ?? "—"}</td>
                <td class="num">{r.expected_credit != null ? money(Number(r.expected_credit)) : "—"}</td>
                <td>
                  <button class="cmw-approve" data-receipt-review="approve" type="button">Approve</button>
                  <button class="cmw-btn cmw-secondary cmw-rerequest" data-receipt-review="rerequest" type="button">Re-request</button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {requests.length === 0 && <p class="cmw-empty">No draft or approved credit memo requests.</p>}

    {tree.map((o) => (
      <details class="cmw-office" open>
        <summary>
          <span class="cmw-chev">›</span>
          <span class="cmw-office-name">{o.office}</span>
          <span class="cmw-mini">
            <span>{approvedOf(o.invoices).length} <em>approved</em></span>
            <span>{lineCountOf(approvedOf(o.invoices))} <em>lines</em></span>
            <span><b>{money(totalOf(approvedOf(o.invoices)))}</b> <em>requested</em></span>
            {draftOf(o.invoices).length > 0 && <span class="cmw-draft-pill">{draftOf(o.invoices).length} draft awaiting approval</span>}
          </span>
        </summary>
        <div class="cmw-office-body">
        {o.vendors.map((v) => (
      <details class="cmw-vendor" open>
        <summary>
          <span class="cmw-chev">›</span>
          <b>{v.vendor}</b>
          <span class="cmw-sum">
            {approvedOf(v.invoices).length} approved invoice(s) · {lineCountOf(approvedOf(v.invoices))} line(s) · <b>{money(totalOf(approvedOf(v.invoices)))}</b>
            {draftOf(v.invoices).length > 0 && <span class="cmw-draft-pill">{draftOf(v.invoices).length} draft awaiting approval</span>}
          </span>
          {/* Records that this office group's approved requests went out with the vendor
              email. No external send happens here (SOUL: nothing leaves the building
              without a human). */}
          {approvedOf(v.invoices).length > 0 && (
            <button class="cmw-approve cmw-marksent" type="button"
              data-cm-mark-sent={v.vendor}
              data-invoices={approvedOf(v.invoices).map((r) => r.invoice_number).join(",")}
              data-total={money(totalOf(approvedOf(v.invoices)))}
              title="Record these approved requests as sent — they move to the Sent CM chase queue">Mark sent →</button>
          )}
        </summary>
        {v.branches.map((br) => (
        <details class="cmw-branch" open>
          <summary>
            <span class="cmw-chev">›</span>
            <span class="cmw-branch-name">{br.branch}</span>
            <span class="cmw-sum">{br.invoices.length} invoice(s) · {lineCountOf(br.invoices)} line(s) · <b>{money(totalOf(approvedOf(br.invoices)))}</b> approved</span>
          </summary>
          <div class="cmw-email">
          {approvedOf(br.invoices).map((r) => (
              <div class="cmw-invoice">
                <p class="cmw-inv-head"><b>Invoice {r.invoice_number}</b> — credit requested: <b>{money(r.expected_credit)}</b> · <a href={`/accounting/credit-memos/${encodeURIComponent(r.invoice_number)}`}>detail →</a>
                  <button class="cmw-approve cmw-marksent" type="button" data-cm-mark-sent={v.vendor}
                    data-invoices={r.invoice_number} data-total={money(r.expected_credit)}
                    title="Record this one invoice as sent — it moves to the Sent CM chase queue">Mark sent →</button></p>
                {/* office/vendor/branch live in the tree above — the invoice line keeps job + date */}
                <p class="cmw-inv-meta">{(() => { const m = headerParts(r.invoice_number, v.vendor); return (<>
                {m.jobNumber
                  ? (m.jobHref ? <a href={m.jobHref} target="_blank" rel="noopener">Job {m.jobNumber} ↗</a> : <span>Job {m.jobNumber}</span>)
                  : <span>no job on the PO</span>}{m.clientName ? ` (${m.clientName})` : ""} · {m.invoiced}
              </>); })()}</p>
                <table>
                  <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Invoiced</th><th class="num">Agreement price</th><th class="num">Credit</th></tr></thead>
                  <tbody>
                    {(linesByInvoice.get(r.invoice_number) ?? []).map((l) => (
                      <tr>
                        <td>{l.item_description}<br /><span class="cmw-reason">{reasonFor(l)}</span></td>
                        <td class="num">{Number(l.quantity)}</td>
                        <td class="num">{money(Number(l.invoiced_price))}</td>
                        <td class="num">{money(Number(l.office_price))}</td>
                        <td class="num"><b>{money(Number(l.variance_ext))}</b></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
          ))}
          {draftOf(br.invoices).map((r) => (
                <details class="cmw-draft-block" data-invoice={r.invoice_number}>
                  <summary>
                    <a href={`/accounting/credit-memos/${encodeURIComponent(r.invoice_number)}`} onclick="event.stopPropagation()">{r.invoice_number}</a>
                    <span>· {money(r.expected_credit)} · <span data-review-count>{draftMeta.get(r.invoice_number)?.reviewed ?? 0}</span>/{draftMeta.get(r.invoice_number)?.claimLines.length ?? 0} lines reviewed</span>
                    <span class="cmw-draft-pill">draft — not in the email yet</span>
                    {(draftMeta.get(r.invoice_number)?.claimLines.length ?? 0) > 0 && (
                      <button class="cmw-approve" data-cm-approve={r.invoice_number} disabled={!draftMeta.get(r.invoice_number)?.allReviewed}
                        title={draftMeta.get(r.invoice_number)?.allReviewed ? "Add this invoice to the vendor email" : "Review (check) every claim line first"} type="button">Approve</button>
                    )}
                    {(draftMeta.get(r.invoice_number)?.claimLines.length ?? 0) === 0 && <span class="cmw-noclaims">no claim lines</span>}
                  </summary>
                  {(draftMeta.get(r.invoice_number)?.claimLines.length ?? 0) > 0 && (
                    <table>
                      <thead><tr><th>Reviewed</th><th>Item</th><th class="num">Qty</th><th class="num">Invoiced</th><th class="num">Agreement</th><th class="num">Credit</th></tr></thead>
                      <tbody>
                        {(draftMeta.get(r.invoice_number)?.claimLines ?? []).map((l) => (
                          <tr>
                            <td class="chk"><input type="checkbox" data-review-line={l.id} checked={!!l.reviewed_at} title={l.reviewed_at ? `Reviewed by ${l.reviewed_by} ${String(l.reviewed_at).slice(0, 10)}` : "Mark this claim line as reviewed"} /></td>
                            <td>{l.item_description}<br /><span class="cmw-reason">{reasonFor(l)}</span></td>
                            <td class="num">{Number(l.quantity)}</td>
                            <td class="num">{money(Number(l.invoiced_price))}</td>
                            <td class="num">{money(Number(l.office_price))}</td>
                            <td class="num"><b>{money(Number(l.variance_ext))}</b></td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  )}
                </details>
          ))}
          </div>
        </details>
        ))}
      </details>
        ))}
        </div>
      </details>
    ))}

    {/* The copyable per-vendor EMAIL — vendor-wide scope (the email is a vendor
        artifact; the tree above is the work surface). Collapsed by default. */}
    {vendors.map((vendor) => (
      <details class="cmw-vendor cmw-emailprev">
        <summary>
          <span class="cmw-chev">›</span>
          <b>Email preview — {vendor}</b>
          <span class="cmw-sum">{approvedFor(vendor).length} approved invoice(s) · {vendorLineCount(vendor)} line(s) · <b>{money(vendorTotal(vendor))}</b></span>
        </summary>
        {approvedFor(vendor).length === 0 ? (
          <p class="cmw-empty">Nothing approved for {vendor} yet.</p>
        ) : (
          <div class="cmw-email">
            <p class="cmw-email-meta">Subject: [{vendor}] Credit memo request - Pro Exteriors LLC - {approvedFor(vendor).length} invoices, {money(vendorTotal(vendor))}</p>
            <p>We are requesting credit memos on {vendorLineCount(vendor)} lines across {approvedFor(vendor).length} invoices. Each line was billed above the price agreement in force for its Pro Exteriors office location on the invoice date. Detail and reasoning are listed by invoice; the same detail is attached as a spreadsheet.</p>
            <p>Total credit requested: <b>{money(vendorTotal(vendor))}</b>.</p>
            <p>Where an agreement lapsed with no successor in place we have priced against that agreement, which remains in force until replaced; those lines carry a PAEXP reference.</p>
            <p>Please issue the credits against the original invoice numbers and confirm.</p>
            {approvedFor(vendor).map((r) => (
              <div class="cmw-invoice">
                <p class="cmw-inv-head"><b>Invoice {r.invoice_number}</b> — credit requested: <b>{money(r.expected_credit)}</b></p>
                <p class="cmw-inv-meta">{(() => { const m = headerParts(r.invoice_number, vendor); return (<>
                {m.lead} · {m.jobNumber ? <span>Job {m.jobNumber}</span> : <span>no job on the PO</span>}{m.clientName ? ` (${m.clientName})` : ""} · {m.invoiced}
              </>); })()}</p>
                <table>
                  <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Invoiced</th><th class="num">Agreement price</th><th class="num">Credit</th></tr></thead>
                  <tbody>
                    {(linesByInvoice.get(r.invoice_number) ?? []).map((l) => (
                      <tr>
                        <td>{l.item_description}<br /><span class="cmw-reason">{reasonFor(l)}</span></td>
                        <td class="num">{Number(l.quantity)}</td>
                        <td class="num">{money(Number(l.invoiced_price))}</td>
                        <td class="num">{money(Number(l.office_price))}</td>
                        <td class="num"><b>{money(Number(l.variance_ext))}</b></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ))}
          </div>
        )}
      </details>
    ))}
  </section>
</AppShell>

<style>
  /* Full-width like the Invoice Audit — the 900px email column left a dead
     right half and stacked the action buttons (Chris 2026-09-01). */
  .cmw{padding:8px 4px 40px}
  /* Office → Vendor → Branch nesting, same visual grammar as .iv-office/.iv-branch */
  .cmw-office{background:#fff;border:1px solid #e3e8ef;border-radius:14px;margin-bottom:12px;overflow:hidden}
  .cmw-office>summary{display:flex;align-items:center;gap:14px;padding:14px 16px;cursor:pointer;list-style:none}
  .cmw-office>summary::-webkit-details-marker{display:none}
  .cmw-office-name{font-weight:750;font-size:15px;flex:1}
  .cmw-office-body{padding:4px 12px 12px;border-top:1px solid #e3e8ef}
  .cmw-chev{color:#6b7886;transition:transform .15s;font-size:15px}
  details[open]>summary .cmw-chev{transform:rotate(90deg)}
  .cmw-mini{display:flex;gap:16px;align-items:center;font-size:12px;color:#6b7886}
  .cmw-mini b{font-variant-numeric:tabular-nums}
  .cmw-mini em{font-style:normal;text-transform:uppercase;font-size:10px;letter-spacing:.03em}
  .cmw-branch{border:1px solid #e3e8ef;border-radius:10px;margin:8px 0;background:#fff}
  .cmw-branch>summary{display:flex;align-items:center;gap:12px;padding:10px 12px;cursor:pointer;list-style:none;flex-wrap:wrap}
  .cmw-branch>summary::-webkit-details-marker{display:none}
  .cmw-branch-name{font-weight:700;font-size:13.5px}
  .cmw-office .cmw-vendor{background:#f7f8fb;margin:8px 0}
  .cmw-emailprev{margin-top:18px}
  .cmw-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .cmw-bar h1{font-size:22px;margin:0}
  .cmw-actions{display:flex;gap:8px;flex-wrap:wrap}
  .cmw-btn{border:1px solid #5b46d8;background:#5b46d8;color:#fff;border-radius:8px;padding:8px 12px;font-size:13px;font-weight:700;text-decoration:none}
  .cmw-btn.cmw-secondary{background:transparent;color:#5b46d8}
  .cmw-note{font-size:13px;color:#6b7886;margin:10px 0 18px}
  .cmw-empty{color:#6b7886;font-size:13px;padding:10px 2px}
  .cmw-vendor{border:1px solid #e3e8ef;border-radius:12px;margin-bottom:14px;background:#fff}
  .cmw-vendor>summary{display:flex;gap:12px;align-items:center;padding:12px 14px;cursor:pointer;font-size:15px;flex-wrap:wrap}
  .cmw-sum{color:#6b7886;font-size:13px;display:inline-flex;gap:8px;align-items:center;flex-wrap:wrap}
  .cmw-draft-pill{background:#fbf0d4;color:#946400;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:700}
  .cmw-email{padding:6px 16px 16px;font-size:14px;line-height:1.5}
  .cmw-email-meta{color:#888;font-size:12.5px}
  .cmw-invoice{margin:18px 0 6px}
  .cmw-inv-head{margin:0 0 2px;font-size:14px}
  .cmw-inv-meta{margin:0 0 6px;font-size:12px;color:#6b7886}
  .cmw-inv-meta a{color:#5b46d8;text-decoration:none}
  .cmw-inv-meta a:hover{text-decoration:underline}
  .cmw-invoice table{width:100%;border-collapse:collapse;font-size:13px;border:1px solid #d0d0d0}
  .cmw-invoice th,.cmw-invoice td{border:1px solid #d0d0d0;padding:6px;text-align:left}
  .cmw-invoice th.num,.cmw-invoice td.num{text-align:right}
  .cmw-reason{color:#666;font-size:12px}
  .cmw-drafts{border-top:1px dashed #e3e8ef;padding:10px 16px 14px}
  .cmw-drafts-title{font-size:12px;color:#6b7886;font-weight:700;margin:0 0 6px}
  .cmw-draft-block{border:1px solid #e3e8ef;border-radius:9px;margin:0 0 8px;background:#f7f8fb}
  .cmw-draft-block>summary{display:flex;align-items:center;gap:8px;padding:8px 12px;font-size:13px;cursor:pointer;flex-wrap:wrap}
  .cmw-draft-block table{width:100%;border-collapse:collapse;font-size:12.5px;border-top:1px solid #e3e8ef}
  .cmw-draft-block th,.cmw-draft-block td{border-bottom:1px solid #e3e8ef;padding:6px 8px;text-align:left}
  .cmw-draft-block th.num,.cmw-draft-block td.num{text-align:right}
  .cmw-draft-block td.chk{text-align:center;width:64px}
  .cmw-draft-block td.chk input{width:16px;height:16px;accent-color:#137a4d;cursor:pointer}
  .cmw-noclaims{color:#6b7886;font-size:12px}
  .cmw-receipts{padding:10px 14px 14px;background:#fffbeb}
  .cmw-receipts table{width:100%;border-collapse:collapse;font-size:12.5px;background:#fff}
  .cmw-receipts th,.cmw-receipts td{border:1px solid #e3e8ef;padding:6px 8px;text-align:left}
  .cmw-receipts th.num,.cmw-receipts td.num{text-align:right}
  .cmw-rerequest{margin-left:6px;font-size:11px;padding:2px 8px;border-radius:6px;cursor:pointer}
  .cmw-approve:disabled{opacity:.45;cursor:not-allowed;filter:grayscale(.4)}
  .cmw-approve{border:1px solid #137a4d;background:#e3f5ec;color:#137a4d;border-radius:6px;padding:2px 8px;font-size:11px;font-weight:700;cursor:pointer}
  .cmw-marksent{margin-left:8px;border-color:#5b46d8;background:#efecfd;color:#5b46d8}
</style>

<script>
  // Per-line review acknowledgment (Chris 2026-08-05): checking a line stamps
  // reviewed_by/at; the Approve button stays greyed until every line is checked.
  document.addEventListener("change", async (ev) => {
    const box = ev.target as HTMLInputElement;
    if (!box?.matches?.("[data-review-line]")) return;
    const reviewed = box.checked;
    box.disabled = true;
    const res = await fetch("/api/credit-memos/review-line", {
      method: "POST",
      headers: { "content-type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ lineId: Number(box.dataset.reviewLine), reviewed }),
    }).then((r) => r.json()).catch(() => null);
    box.disabled = false;
    if (!res?.lineId) { box.checked = !reviewed; window.alert("Saving the review failed: " + (res?.error_description || res?.error || "network error")); return; }
    const block = box.closest(".cmw-draft-block") as HTMLElement;
    const boxes = [...block.querySelectorAll<HTMLInputElement>("[data-review-line]")];
    const done = boxes.filter((b) => b.checked).length;
    const counter = block.querySelector("[data-review-count]");
    if (counter) counter.textContent = String(done);
    const approveBtn = block.querySelector("[data-cm-approve]") as HTMLButtonElement | null;
    if (approveBtn) {
      const all = done === boxes.length;
      approveBtn.disabled = !all;
      approveBtn.title = all ? "Add this invoice to the vendor email" : "Review (check) every claim line first";
    }
  });

  document.addEventListener("click", async (ev) => {
    const rbtn = (ev.target as HTMLElement)?.closest?.("[data-receipt-review]") as HTMLButtonElement | null;
    if (rbtn) {
      const row = rbtn.closest("[data-receipt]") as HTMLElement;
      rbtn.disabled = true;
      const res = await fetch("/api/credit-memos/receipt-review", {
        method: "POST",
        headers: { "content-type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ cmInvoiceNumber: row.dataset.receipt, action: rbtn.dataset.receiptReview }),
      }).then((r) => r.json()).catch(() => null);
      if (res?.cmInvoiceNumber) row.remove();
      else { rbtn.disabled = false; window.alert("Review failed: " + (res?.error_description || res?.error || "network error")); }
      return;
    }
    // Mark sent — records the vendor email as sent and moves the request to Chase it.
    const sbtn = (ev.target as HTMLElement)?.closest?.("[data-cm-mark-sent]") as HTMLButtonElement | null;
    if (sbtn) {
      ev.preventDefault();
      ev.stopPropagation(); // the vendor button lives inside <summary>
      const vendor = sbtn.dataset.cmMarkSent!;
      const invoices = (sbtn.dataset.invoices || "").split(",").map((x) => x.trim()).filter(Boolean);
      if (!invoices.length) return;
      const ok = window.confirm(
        `Mark ${invoices.length} ${vendor} request(s) — ${sbtn.dataset.total} — as SENT?\n\n` +
        `This does not email anything. It records that you sent the email, moves these to the Sent CM chase queue, ` +
        `and starts the 14-day follow-up clock.`);
      if (!ok) return;
      const label = sbtn.textContent;
      sbtn.disabled = true;
      const failed: string[] = [];
      for (let i = 0; i < invoices.length; i += 1) {
        sbtn.textContent = `Sending ${i + 1}/${invoices.length}…`;
        const res = await fetch("/api/credit-memos/disposition", {
          method: "POST",
          headers: { "content-type": "application/json" },
          credentials: "same-origin",
          body: JSON.stringify({ invoiceNumber: invoices[i], decision: "mark-sent" }),
        }).then((r) => r.json()).catch(() => null);
        if (res?.record?.status !== "sent") failed.push(invoices[i]);
      }
      if (failed.length) {
        sbtn.disabled = false;
        sbtn.textContent = label;
        window.alert(`${invoices.length - failed.length} of ${invoices.length} marked sent. Failed: ${failed.join(", ")}`);
      }
      window.location.reload();
      return;
    }

    const btn = (ev.target as HTMLElement)?.closest?.("[data-cm-approve]") as HTMLButtonElement | null;
    if (!btn) return;
    btn.disabled = true;
    const res = await fetch("/api/credit-memos/approve", {
      method: "POST",
      headers: { "content-type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ invoiceNumber: btn.dataset.cmApprove, approve: true }),
    }).then((r) => r.json()).catch(() => null);
    if (res?.status === "approved") window.location.reload();
    else { btn.disabled = false; window.alert("Approve failed: " + (res?.error_description || res?.error || "network error")); }
  });
</script>
