---
// Sent credit memo workspace — the chase surface. An exact replica of the Weekly CM
// workspace (weekly.astro), scoped to requests already WITH the vendor
// (status = 'sent') instead of the ones still being assembled (draft/approved), with
// the language moved from "Request" to "Sent".
//
// Why it re-renders rather than replays: nothing stores the email body that was
// actually sent — `packet` on all 44 sent rows carries provenance keys only
// (source / line_added_at / line_added_by), no HTML. So this composes the email from
// TODAY's audit lines. That matters: docs/93's re-audit revised some sent figures, so a
// line here can differ from what the vendor received. The page says so on its face
// rather than implying it is a copy of the outbound mail.
import AppShell from "../../../layouts/AppShell.astro";
import { cmVendorBySlug, cmVendorLabel } from "@lib/cm-vendor-roster";
import { acculynxJobHref, loadCmRequestHeaders, type CmRequestHeader } from "@lib/cm-request-header";
import { createServerSupabaseClient } from "@lib/supabase.server";

const vendorParam = cmVendorBySlug(Astro.url.searchParams.get("vendor"))?.slug ?? null;

interface CmLine {
  id: number; invoice_number: string; item_number: string | null; item_description: string; quantity: number; invoiced_price: number;
  office_price: number; variance_ext: number; office_name: string; agreement_number: string | null;
  agreement_effective: string | null; agreement_expiry: string | null; match_method: string; paexp_tag: string | null;
  run_label: string; created_at: string; reviewed_by: string | null; reviewed_at: string | null;
}

const { client } = createServerSupabaseClient();
let requests: { invoice_number: string; status: string; expected_credit: number; vendor: string; sent_at: string | null; follow_up_due_at: string | null }[] = [];
const linesByInvoice = new Map<string, CmLine[]>();
// PE office / vendor / vendor branch / job / invoice date for each claim header.
let headers = new Map<string, CmRequestHeader>();
interface CmReceipt {
  cm_invoice_number: string; cm_total: number; cm_invoice_date: string | null;
  match_state: string; original_invoice_number: string | null; expected_credit: number | null;
  matched_request_id: string | null; vendor_slug: string;
}
// The credit memo document's own lines, keyed by cm invoice number — rendered
// nested (light green) under the request lines (light red) they answer.
interface CmDocLine { item_number: string | null; item_description: string | null; qty: number; uom: string; unit_price: number | null; extended_price: number | null; }
let pendingReceipts: CmReceipt[] = [];
const cmLinesByDoc = new Map<string, CmDocLine[]>();
if (client) {
  let receiptQuery = client
    .from("credit_memo_receipts")
    .select("cm_invoice_number, cm_total, cm_invoice_date, match_state, original_invoice_number, expected_credit, matched_request_id, vendor_slug")
    .eq("review_status", "pending");
  if (vendorParam) receiptQuery = receiptQuery.eq("vendor_slug", vendorParam);
  const { data: receiptRows } = await receiptQuery.order("created_at", { ascending: false }).limit(200);
  pendingReceipts = (receiptRows ?? []) as CmReceipt[];

  // CM document lines: SRS/QXO from vendor_invoice_lines, ABC from abc_invoice_lines.
  const nonAbc = pendingReceipts.filter((r) => r.vendor_slug !== "abc-supply").map((r) => r.cm_invoice_number);
  const abc = pendingReceipts.filter((r) => r.vendor_slug === "abc-supply").map((r) => r.cm_invoice_number);
  const CHUNK = 100;
  for (let i = 0; i < nonAbc.length; i += CHUNK) {
    const { data } = await client
      .from("vendor_invoice_lines")
      .select("invoice_number, item_number, item_description, ship_qty, price_uom, ship_uom, unit_price, extended_price")
      .in("invoice_number", nonAbc.slice(i, i + CHUNK))
      .limit(2000);
    for (const l of data ?? []) {
      const list = cmLinesByDoc.get(String(l.invoice_number)) ?? [];
      list.push({ item_number: l.item_number, item_description: l.item_description, qty: Number(l.ship_qty ?? 0), uom: String(l.price_uom ?? l.ship_uom ?? ""), unit_price: l.unit_price == null ? null : Number(l.unit_price), extended_price: l.extended_price == null ? null : Number(l.extended_price) });
      cmLinesByDoc.set(String(l.invoice_number), list);
    }
  }
  for (let i = 0; i < abc.length; i += CHUNK) {
    const { data } = await client
      .from("abc_invoice_lines")
      .select("invoice_number, item_number, item_description, quantity, uom, unit_price, extended_price")
      .in("invoice_number", abc.slice(i, i + CHUNK))
      .limit(2000);
    for (const l of data ?? []) {
      const list = cmLinesByDoc.get(String(l.invoice_number)) ?? [];
      list.push({ item_number: l.item_number, item_description: l.item_description, qty: Number(l.quantity ?? 0), uom: String(l.uom ?? ""), unit_price: l.unit_price == null ? null : Number(l.unit_price), extended_price: l.extended_price == null ? null : Number(l.extended_price) });
      cmLinesByDoc.set(String(l.invoice_number), list);
    }
  }

  let reqQuery = client
    .from("credit_memo_requests")
    .select("invoice_number, vendor_slug, status, expected_credit, packet, sent_at, follow_up_due_at")
    .eq("request_kind", "requested")
    .eq("status", "sent");
  if (vendorParam) reqQuery = reqQuery.eq("vendor_slug", vendorParam);
  const { data: reqRows } = await reqQuery.order("invoice_number").limit(1000);
  requests = (reqRows ?? []).map((r) => ({
    invoice_number: r.invoice_number,
    status: r.status,
    expected_credit: Number(r.expected_credit ?? 0),
    // vendor_slug is the silo key (docs/87); packet.vendor is only a legacy fallback.
    vendor: cmVendorLabel((r as any).vendor_slug) ?? (((r.packet as Record<string, unknown> | null)?.vendor as string) ?? "ABC Supply"),
    sent_at: (r as any).sent_at ?? null,
    follow_up_due_at: (r as any).follow_up_due_at ?? null,
  }));
  const invoiceNumbers = requests.map((r) => r.invoice_number);
  if (invoiceNumbers.length) {
    // Chunked .in() — a long URL filter is its own truncation trap.
    const CHUNK = 200;
    const lineRows: CmLine[] = [];
    for (let i = 0; i < invoiceNumbers.length; i += CHUNK) {
      let lineQuery = client
        .from("invoice_line_reaudit")
        .select("id, run_label, invoice_number, item_number, item_description, quantity, invoiced_price, office_name, office_price, variance_ext, agreement_number, agreement_effective, agreement_expiry, match_method, paexp_tag, created_at, reviewed_by, reviewed_at")
        .in("invoice_number", invoiceNumbers.slice(i, i + CHUNK))
        .eq("classification", "discrepancy");
      // Silo (docs/87): a colliding invoice number must not pull another vendor's lines.
      if (vendorParam) lineQuery = lineQuery.eq("vendor_slug", vendorParam);
      const { data } = await lineQuery.order("created_at", { ascending: false }).limit(2000);
      lineRows.push(...((data ?? []) as CmLine[]));
    }
    const latestRun = new Map<string, string>();
    for (const l of lineRows) if (!latestRun.has(l.invoice_number)) latestRun.set(l.invoice_number, l.run_label);
    for (const l of lineRows) {
      if (latestRun.get(l.invoice_number) !== l.run_label) continue;
      if (Number(l.variance_ext ?? 0) < 0.05) continue;
      (linesByInvoice.get(l.invoice_number) ?? linesByInvoice.set(l.invoice_number, []).get(l.invoice_number)!).push(l);
    }
    headers = await loadCmRequestHeaders(client, invoiceNumbers);
  }
}

const vendors = [...new Set(requests.map((r) => r.vendor))].sort();
const money = (n: number) => "$" + Number(n).toLocaleString("en-US", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
const sentFor = (vendor: string) => requests.filter((r) => r.vendor === vendor);
const vendorTotal = (vendor: string) => sentFor(vendor).reduce((s, r) => s + r.expected_credit, 0);
const vendorLineCount = (vendor: string) => sentFor(vendor).reduce((s, r) => s + (linesByInvoice.get(r.invoice_number)?.length ?? 0), 0);
const day = (iso: string | null) => (iso ? String(iso).slice(0, 10) : null);
const nowIso = new Date().toISOString();
const isOverdue = (r: { follow_up_due_at: string | null }) => !!r.follow_up_due_at && String(r.follow_up_due_at) < nowIso;
const overdueFor = (vendor: string) => sentFor(vendor).filter(isOverdue).length;
// Same header contract as Weekly CM — loaded through the shared helper so the two
// surfaces cannot drift apart.
// PE Office · Vendor · Vendor branch (id) · Job# · Invoice date. Split so the job can be
// a real AccuLynx link; missing pieces are NAMED, never blanked, so a gap is visible.
const headerParts = (invoiceNumber: string, vendor: string) => {
  const h = headers.get(invoiceNumber);
  const branch = h?.branchName || h?.branchNumber
    ? (h.branchNumber ? `${h.branchName} (${h.branchNumber})` : h.branchName)
    : "branch not resolved";
  return {
    lead: [h?.office || "office not resolved", vendor, branch].join(" · "),
    jobNumber: h?.jobNumber ?? "",
    jobHref: acculynxJobHref(h?.acculynxJobId ?? null),
    clientName: h?.clientName ?? "",
    invoiced: h?.invoiceDate ? `Invoiced ${h.invoiceDate}` : "invoice date unknown",
  };
};
// Nested review model (Chris 2026-09-01): a received CM renders INSIDE the sent
// request's own block — each request claim line (light red) is followed by the
// CM document line that answers it (light green), matched by item number, so the
// human audits them pair by pair. CM lines with no request counterpart trail the
// table, still green, labeled as extra.
const receiptsByReqInvoice = new Map<string, CmReceipt[]>();
for (const r of pendingReceipts) {
  if (!r.original_invoice_number) continue;
  const list = receiptsByReqInvoice.get(r.original_invoice_number) ?? [];
  list.push(r);
  receiptsByReqInvoice.set(r.original_invoice_number, list);
}
// Receipts whose request block is on this page nest there; the rest (no open
// request, or the request already left the chase queue) keep the flat table.
const renderedReqInvoices = new Set(requests.map((r) => r.invoice_number));
const standaloneReceipts = pendingReceipts.filter(
  (rc) => !rc.original_invoice_number || !renderedReqInvoices.has(rc.original_invoice_number));
// CM line descriptions from the portal CSV carry trailing note rows
// (SUB-TOTAL / Sales Tax separators). Keep the substance — item text, the
// Orig Inv# ref, and the vendor's Reason — drop the ledger noise.
const cleanCmDesc = (d: string | null) =>
  String(d ?? "")
    .split("|")
    .map((s) => s.trim())
    .filter((s) => s && !/^\*+.*\*+$/.test(s) && !/^sales tax/i.test(s) && !/^sub-?total/i.test(s))
    .join(" | ");
const matchBasisLabel = (rc: CmReceipt) =>
  rc.match_state === "amount_mismatch" && rc.matched_request_id
    ? "the memo names this invoice (Orig Inv#) — amounts differ, your call"
    : rc.match_state.replace(/_/g, " ");
const pairingFor = (invoiceNumber: string) => {
  const receipts = receiptsByReqInvoice.get(invoiceNumber) ?? [];
  const reqLines = linesByInvoice.get(invoiceNumber) ?? [];
  const cmPool: { rc: CmReceipt; cl: CmDocLine; used: boolean }[] = receipts.flatMap((rc) =>
    (cmLinesByDoc.get(rc.cm_invoice_number) ?? []).map((cl) => ({ rc, cl, used: false })));
  const rows: ({ kind: "req"; line: CmLine } | { kind: "cm"; rc: CmReceipt; cl: CmDocLine; extra: boolean })[] = [];
  for (const line of reqLines) {
    rows.push({ kind: "req", line });
    for (const p of cmPool) {
      if (p.used || !p.cl.item_number || !line.item_number) continue;
      if (String(p.cl.item_number).trim().toUpperCase() !== String(line.item_number).trim().toUpperCase()) continue;
      p.used = true;
      rows.push({ kind: "cm", rc: p.rc, cl: p.cl, extra: false });
    }
  }
  for (const p of cmPool) if (!p.used) rows.push({ kind: "cm", rc: p.rc, cl: p.cl, extra: true });
  return { receipts, rows };
};
const reasonFor = (l: CmLine) => {
  const pct = l.office_price ? (((Number(l.invoiced_price) - Number(l.office_price)) / Number(l.office_price)) * 100).toFixed(1) : "?";
  const agreement = l.agreement_number
    ? `agreement ${l.agreement_number}${l.agreement_effective ? ` (eff. ${l.agreement_effective}${l.agreement_expiry ? ` to ${l.agreement_expiry}` : ""})` : ""}`
    : "negotiated price list on file";
  const office = l.office_name ? `the ${l.office_name} office ` : "our ";
  let r = `Billed ${money(Number(l.invoiced_price))} against ${money(Number(l.office_price))} on ${office}${agreement} - overcharge ${pct}%.`;
  if (l.paexp_tag) r += ` The agreement had lapsed without a successor and remains in force (${l.paexp_tag}).`;
  return r;
};
---

<AppShell title="Sent Credit Memo Requests" eyebrow="Accounting" activePage="accounting">
  <section class="cmw">
    <div class="cmw-bar">
      <h1>Sent Credit Memo Requests{vendorParam ? ` — ${cmVendorLabel(vendorParam)}` : ""}</h1>
      <div class="cmw-actions">
        <a class="cmw-btn" href={`/api/credit-memos/weekly-csv?kind=detail&status=sent${vendorParam ? `&vendor=${encodeURIComponent(vendorParam)}` : ""}`} download>⬇ Reconciliation spreadsheet</a>
        <a class="cmw-btn" href={`/api/credit-memos/weekly-csv?kind=tracker&status=sent${vendorParam ? `&vendor=${encodeURIComponent(vendorParam)}` : ""}`} download>⬇ Tracker CSV</a>
        {vendorParam && <a class="cmw-btn cmw-secondary" href="/accounting/credit-memos/sent">All vendors</a>}
        <a class="cmw-btn cmw-secondary" href="/accounting/credit-memos/weekly">Weekly CM →</a>
        <a class="cmw-btn cmw-secondary" href="/accounting/invoice-audit">← Invoice Audit</a>
      </div>
    </div>
    <p class="cmw-note">Requests already <b>sent</b> to the vendor and awaiting credit — this is the chase queue. Mark received when the credit lands; the invoice then leaves this page. Use <a href="/accounting/credit-memos/weekly">Weekly CM</a> for requests still being assembled.</p>
    <p class="cmw-note cmw-warn">The email below is <b>rebuilt from today's audit lines</b> — no copy of the outbound message is stored, so a figure here can differ from what the vendor actually received if the line was re-audited after sending.</p>

    {standaloneReceipts.length > 0 && (
      <div class="cmw-vendor cmw-receipts">
        <p class="cmw-drafts-title">Credit memos received with no open request on this page ({standaloneReceipts.length}) — returns, rebates, or credits whose request already closed. Expand a row to see the memo's own lines; Approve accepts the credit as-is, Re-request keeps our request open.</p>
        <table>
          <thead><tr><th>Credit memo</th><th class="num">Amount</th><th>Date</th><th>Match state</th><th>Original invoice</th><th class="num">Expected</th><th></th></tr></thead>
          <tbody>
            {standaloneReceipts.map((r) => (
              <>
                <tr data-receipt={r.cm_invoice_number}>
                  <td>{r.cm_invoice_number}</td>
                  <td class="num">{money(Number(r.cm_total))}</td>
                  <td>{r.cm_invoice_date ?? ""}</td>
                  <td>{r.match_state.replace(/_/g, " ")}</td>
                  <td>{r.original_invoice_number ?? "—"}</td>
                  <td class="num">{r.expected_credit != null ? money(Number(r.expected_credit)) : "—"}</td>
                  <td>
                    <button class="cmw-approve" data-receipt-review="approve" type="button">Approve</button>
                    <button class="cmw-btn cmw-secondary cmw-rerequest" data-receipt-review="rerequest" type="button">Re-request</button>
                  </td>
                </tr>
                {(cmLinesByDoc.get(r.cm_invoice_number) ?? []).map((cl) => (
                  <tr class="cmw-cm-row">
                    <td colspan="4">{cl.item_number}{cl.item_description ? ` — ${cleanCmDesc(cl.item_description)}` : ""}</td>
                    <td class="num">{cl.qty} {cl.uom}</td>
                    <td class="num">{cl.unit_price != null ? money(cl.unit_price) : "—"}</td>
                    <td class="num">{cl.extended_price != null ? money(cl.extended_price) : "—"}</td>
                  </tr>
                ))}
              </>
            ))}
          </tbody>
        </table>
      </div>
    )}

    {requests.length === 0 && <p class="cmw-empty">No sent credit memo requests are awaiting credit.</p>}

    {vendors.map((vendor) => (
      <details class="cmw-vendor" open>
        <summary>
          <b>{vendor}</b>
          <span class="cmw-sum">
            {sentFor(vendor).length} sent invoice(s) · {vendorLineCount(vendor)} line(s) · <b>{money(vendorTotal(vendor))}</b>
            {overdueFor(vendor) > 0 && <span class="cmw-overdue-pill">{overdueFor(vendor)} overdue (+14d)</span>}
          </span>
        </summary>
        <div class="cmw-email">
          <p class="cmw-email-meta">Subject: [{vendor}] Credit memo request - Pro Exteriors LLC - {sentFor(vendor).length} invoices, {money(vendorTotal(vendor))} — <b>Requested</b></p>
          <p>We requested credit memos on {vendorLineCount(vendor)} lines across {sentFor(vendor).length} invoices. Each line was billed above the price agreement in force for its Pro Exteriors office location on the invoice date. Detail and reasoning are listed by invoice; the same detail is attached as a spreadsheet.</p>
          <p>Total credit Requested: <b>{money(vendorTotal(vendor))}</b>.</p>
          <p>Where an agreement lapsed with no successor in place we priced against that agreement, which remains in force until replaced; those lines carry a PAEXP reference.</p>
          <p>Please issue the credits against the original invoice numbers and confirm.</p>
          {sentFor(vendor).map((r) => (
            <div class="cmw-invoice" data-invoice={r.invoice_number}>
              <p class="cmw-inv-head">
                <b>Invoice {r.invoice_number}</b> — credit Requested: <b>{money(r.expected_credit)}</b>
                {day(r.sent_at) && <span class="cmw-sent-meta"> · Requested {day(r.sent_at)}</span>}
                {r.follow_up_due_at && <span class:list={["cmw-sent-meta", isOverdue(r) && "cmw-overdue"]}> · follow-up {day(r.follow_up_due_at)}{isOverdue(r) ? " (overdue)" : ""}</span>}
                {" · "}<a href={`/accounting/credit-memos/${encodeURIComponent(r.invoice_number)}`}>detail →</a>
                <button class="cmw-approve cmw-received" data-cm-received={r.invoice_number} type="button" title="The vendor credit landed — close this request">Mark received</button>
              </p>
              <p class="cmw-inv-meta">{(() => { const m = headerParts(r.invoice_number, vendor); return (<>
                {m.lead} · {m.jobNumber
                  ? (m.jobHref ? <a href={m.jobHref} target="_blank" rel="noopener">Job {m.jobNumber} ↗</a> : <span>Job {m.jobNumber}</span>)
                  : <span>no job on the PO</span>}{m.clientName ? ` (${m.clientName})` : ""} · {m.invoiced}
              </>); })()}</p>
              {(() => { const pairing = pairingFor(r.invoice_number); return (<>
                {pairing.receipts.map((rc) => (
                  <p class="cmw-receipt-strip" data-receipt={rc.cm_invoice_number}>
                    <b>Credit memo {rc.cm_invoice_number}</b> received {rc.cm_invoice_date ?? ""} · <b>{money(Math.abs(Number(rc.cm_total)))}</b> credited vs <b>{money(r.expected_credit)}</b> requested · {matchBasisLabel(rc)}
                    <button class="cmw-approve" data-receipt-review="approve" type="button" title="Accept this credit as satisfying the request">Approve</button>
                    <button class="cmw-btn cmw-secondary cmw-rerequest" data-receipt-review="rerequest" type="button" title="Keep our request open — the credit does not cover it">Re-request</button>
                  </p>
                ))}
                <table>
                  <thead><tr><th>Item</th><th class="num">Qty</th><th class="num">Invoiced</th><th class="num">Agreement price</th><th class="num">Credit</th></tr></thead>
                  <tbody>
                    {pairing.rows.map((row) => row.kind === "req" ? (
                      <tr class:list={[pairing.receipts.length > 0 && "cmw-req-row"]}>
                        <td>{row.line.item_description}<br /><span class="cmw-reason">{reasonFor(row.line)}</span></td>
                        <td class="num">{Number(row.line.quantity)}</td>
                        <td class="num">{money(Number(row.line.invoiced_price))}</td>
                        <td class="num">{money(Number(row.line.office_price))}</td>
                        <td class="num"><b>{money(Number(row.line.variance_ext))}</b></td>
                      </tr>
                    ) : (
                      <tr class="cmw-cm-row">
                        <td><span class="cmw-cm-tag">CM {row.rc.cm_invoice_number}</span> {row.cl.item_number}{row.cl.item_description ? ` — ${cleanCmDesc(row.cl.item_description)}` : ""}{row.extra ? " · no matching request line" : ""}</td>
                        <td class="num">{row.cl.qty} {row.cl.uom}</td>
                        <td class="num">{row.cl.unit_price != null ? money(row.cl.unit_price) : "—"}</td>
                        <td class="num">—</td>
                        <td class="num"><b>{row.cl.extended_price != null ? money(Math.abs(row.cl.extended_price)) : "—"}</b></td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </>); })()}
              {(linesByInvoice.get(r.invoice_number) ?? []).length === 0 && (
                <p class="cmw-noclaims">No claim lines are on file for this invoice's latest re-audit run — the request was sent from an earlier run.</p>
              )}
            </div>
          ))}
        </div>
      </details>
    ))}
  </section>
</AppShell>

<style>
  .cmw{padding:8px 4px 40px;max-width:900px}
  .cmw-bar{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
  .cmw-bar h1{font-size:22px;margin:0}
  .cmw-actions{display:flex;gap:8px;flex-wrap:wrap}
  .cmw-btn{border:1px solid #5b46d8;background:#5b46d8;color:#fff;border-radius:8px;padding:8px 12px;font-size:13px;font-weight:700;text-decoration:none}
  .cmw-btn.cmw-secondary{background:transparent;color:#5b46d8}
  .cmw-note{font-size:13px;color:#6b7886;margin:10px 0 8px}
  .cmw-note a{color:#5b46d8}
  .cmw-warn{background:#fbf0d4;color:#946400;border:1px solid #f0dca4;border-radius:8px;padding:8px 11px;margin-bottom:18px}
  .cmw-empty{color:#6b7886;font-size:13px;padding:10px 2px}
  .cmw-vendor{border:1px solid #e3e8ef;border-radius:12px;margin-bottom:14px;background:#fff}
  .cmw-vendor>summary{display:flex;gap:12px;align-items:center;padding:12px 14px;cursor:pointer;font-size:15px;flex-wrap:wrap}
  .cmw-sum{color:#6b7886;font-size:13px;display:inline-flex;gap:8px;align-items:center;flex-wrap:wrap}
  .cmw-overdue-pill{background:#fbe2e2;color:#a51f1f;border-radius:999px;padding:2px 9px;font-size:11px;font-weight:700}
  .cmw-email{padding:6px 16px 16px;font-size:14px;line-height:1.5}
  .cmw-email-meta{color:#888;font-size:12.5px}
  .cmw-invoice{margin:18px 0 6px}
  .cmw-inv-head{margin:0 0 2px;font-size:14px}
  .cmw-inv-meta{margin:0 0 6px;font-size:12px;color:#6b7886}
  .cmw-inv-meta a{color:#5b46d8;text-decoration:none}
  .cmw-inv-meta a:hover{text-decoration:underline}
  .cmw-sent-meta{color:#6b7886;font-size:12.5px}
  .cmw-overdue{color:#a51f1f;font-weight:700}
  .cmw-invoice table{width:100%;border-collapse:collapse;font-size:13px;border:1px solid #d0d0d0}
  .cmw-invoice th,.cmw-invoice td{border:1px solid #d0d0d0;padding:6px;text-align:left}
  .cmw-invoice th.num,.cmw-invoice td.num{text-align:right}
  .cmw-reason{color:#666;font-size:12px}
  .cmw-drafts-title{font-size:12px;color:#6b7886;font-weight:700;margin:0 0 6px}
  .cmw-noclaims{color:#6b7886;font-size:12px;margin:6px 0 0}
  /* Nested CM review: request lines light red, the vendor's CM lines light green,
     paired row-under-row for line-by-line human audit (Chris 2026-09-01). */
  .cmw-req-row td{background:#fdeeee}
  .cmw-cm-row td{background:#e9f7ef}
  .cmw-cm-tag{display:inline-block;background:#137a4d;color:#fff;border-radius:5px;padding:1px 6px;font-size:10.5px;font-weight:700;margin-right:5px}
  .cmw-receipt-strip{margin:8px 0 6px;padding:8px 11px;border:1px solid #bfe6d0;background:#e9f7ef;border-radius:8px;font-size:13px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
  .cmw-receipts{padding:10px 14px 14px;background:#fffbeb}
  .cmw-receipts table{width:100%;border-collapse:collapse;font-size:12.5px;background:#fff}
  .cmw-receipts th,.cmw-receipts td{border:1px solid #e3e8ef;padding:6px 8px;text-align:left}
  .cmw-receipts th.num,.cmw-receipts td.num{text-align:right}
  .cmw-rerequest{margin-left:6px;font-size:11px;padding:2px 8px;border-radius:6px;cursor:pointer}
  .cmw-approve{border:1px solid #137a4d;background:#e3f5ec;color:#137a4d;border-radius:6px;padding:2px 8px;font-size:11px;font-weight:700;cursor:pointer}
  .cmw-approve:disabled{opacity:.45;cursor:not-allowed;filter:grayscale(.4)}
  .cmw-received{margin-left:8px}
</style>

<script>
  document.addEventListener("click", async (ev) => {
    // Received-credit triage — identical contract to the Weekly CM page.
    const rbtn = (ev.target as HTMLElement)?.closest?.("[data-receipt-review]") as HTMLButtonElement | null;
    if (rbtn) {
      const row = rbtn.closest("[data-receipt]") as HTMLElement;
      rbtn.disabled = true;
      const res = await fetch("/api/credit-memos/receipt-review", {
        method: "POST",
        headers: { "content-type": "application/json" },
        credentials: "same-origin",
        body: JSON.stringify({ cmInvoiceNumber: row.dataset.receipt, action: rbtn.dataset.receiptReview }),
      }).then((r) => r.json()).catch(() => null);
      if (res?.cmInvoiceNumber) row.remove();
      else { rbtn.disabled = false; window.alert("Review failed: " + (res?.error_description || res?.error || "network error")); }
      return;
    }

    // Mark received — the sent page's equivalent of Weekly's Approve: it closes the
    // request, so the invoice drops off this chase queue.
    const btn = (ev.target as HTMLElement)?.closest?.("[data-cm-received]") as HTMLButtonElement | null;
    if (!btn) return;
    const invoiceNumber = btn.dataset.cmReceived!;
    if (!window.confirm(`Mark ${invoiceNumber} as received? It leaves the chase queue.`)) return;
    btn.disabled = true;
    const res = await fetch("/api/credit-memos/disposition", {
      method: "POST",
      headers: { "content-type": "application/json" },
      credentials: "same-origin",
      body: JSON.stringify({ invoiceNumber, decision: "mark-received" }),
    }).then((r) => r.json()).catch(() => null);
    if (res?.record?.status === "received") {
      btn.closest(".cmw-invoice")?.remove();
    } else {
      btn.disabled = false;
      window.alert("Mark received failed: " + (res?.error_description || res?.error || "network error"));
    }
  });
</script>
