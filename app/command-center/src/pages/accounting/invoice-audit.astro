---
import AppShell from "../../layouts/AppShell.astro";
import { loadInvoiceAuditSummary } from "@lib/invoice-audit";
import { loadKpiPills } from "@lib/kpi-pills";
import { logPerfMetrics, payloadBytes, serverTiming, timeAsync, type PerfMetric } from "@lib/perf";

// The Service/Warranty page variant (?audit=service_warranty) was retired in docs/82
// §5.4 — the transfer flow and queue table remain, and this audit still EXCLUDES the
// transferred Commercial ship-to invoices.
const loadSummary = (opts: { force: boolean }) => loadInvoiceAuditSummary(undefined, opts);

const perfMetrics: PerfMetric[] = [];
const forceLiveRefresh = Astro.url.searchParams.has("refresh") || Astro.url.searchParams.has("live");
let data = await timeAsync("invoice_audit.summary", () => loadSummary({ force: forceLiveRefresh }), perfMetrics);
if (!forceLiveRefresh && (data.status !== "live" || data.totals.invoices === 0)) {
  data = await timeAsync("invoice_audit.summary.force", () => loadSummary({ force: true }), perfMetrics);
}
const generatedAt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }).format(new Date(data.generatedAt));
const runtimeTone = data.status === "live" ? "ready" : "watch";
const runtimeLabel = data.status === "live" ? "Supabase live" : "Supabase pending";
const offices = data.offices.map((o) => o.office);
const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");

// KPI pills (PEC-198, Chris-approved 2026-08-09): the task-first 7-pill set.
// ONE loader (lib/kpi-pills.ts) feeds this render AND /api/accounting/kpi-pills —
// the client re-fetches after every action + a 60s visible-tab poll (PEC-197).
const kpi = await timeAsync("invoice_audit.kpis", () => loadKpiPills(), perfMetrics);
const auditPendingCount = kpi.auditPendingCount;

const initialPayload = { offices: data.offices, categories: data.categories };
const initialPayloadBytes = payloadBytes(initialPayload);
perfMetrics.push({ name: "invoice_audit.initial_payload", durationMs: 0, description: `${initialPayloadBytes} bytes` });
Astro.response.headers.set("server-timing", serverTiming(perfMetrics));
logPerfMetrics("invoice-audit", perfMetrics);
const payload = JSON.stringify(initialPayload).replace(/</g, "\u003c");
---

<AppShell title="Invoice Audit" eyebrow="Accounting" activePage="accounting">
  <section class="iv" data-theme="light" data-pref="system" data-initial-payload-bytes={initialPayloadBytes}>
    <div class="iv-toolbar">
      <input class="iv-input" id="iv-search" type="search" placeholder="Search invoice, item, branch…" autocomplete="off" />
      <select class="iv-select" id="iv-office">
        <option value="">All PE offices</option>
        {offices.map((o) => <option value={o}>{o}</option>)}
      </select>
      {/* ONE scope control, not three checkboxes. "Show all", "To-audit only" and
          "Due now" were three ways of answering the same question — which slice of
          invoices am I looking at — and you had to read all three states and know how
          they composed. The hidden inputs below stay so the tree script, the Due-Now
          card button and any deep link keep working unchanged. */}
      <div class="iv-scope" role="group" aria-label="Invoice scope">
        <button type="button" data-scope="audit" class="is-active" title="Open, unpaid invoices that still have lines to audit">To audit</button>
        <button type="button" data-scope="due" title="Payment due — invoice date + 60 days or older">Due now</button>
        <button type="button" data-scope="all" title="Every invoice, including paid and credit memos">All</button>
      </div>
      <input type="checkbox" id="iv-showall" hidden />
      <input type="checkbox" id="iv-pending" checked hidden />
      <input type="checkbox" id="iv-duenow" hidden />

      <details class="iv-more">
        <summary title="Invoice date range and variance tolerance">More filters</summary>
        <div class="iv-more-body">
          <label class="iv-daterange" title="Invoice date range (defaults to the oldest open invoice date → today)">
            <span class="iv-daterange-lab">Invoice date</span>
            <input class="iv-date" id="iv-date1" type="date" value={data.scope.defaultFrom} max={data.scope.defaultTo} data-cap={data.scope.defaultTo} data-default={data.scope.defaultFrom} aria-label="From date" />
            <span class="iv-daterange-sep">→</span>
            <input class="iv-date" id="iv-date2" type="date" value={data.scope.defaultTo} max={data.scope.defaultTo} data-cap={data.scope.defaultTo} data-default={data.scope.defaultTo} aria-label="To date" />
          </label>
          <select class="iv-select" id="iv-tol">
            <option value="">All tolerance</option>
            <option value="0.01">Flagged ≥ Minor</option>
            <option value="3">Moderate +</option>
            <option value="6">Major only</option>
            <option value="noprice">No-Price lines</option>
          </select>
        </div>
      </details>
      <span class="iv-spacer"></span>
      <span class="runtime-pill" data-tone={runtimeTone}><span class="signal-dot" aria-hidden="true"></span>{runtimeLabel}</span>
      <span class="iv-count">{generatedAt}</span>
      <div class="iv-theme" role="group" aria-label="Theme">
        <button type="button" data-set-theme="system" class="is-active">System</button>
        <button type="button" data-set-theme="light">Light</button>
        <button type="button" data-set-theme="dark">Dark</button>
      </div>
    </div>

    <p class="iv-kpis-scope">Four cards, grouped by the question you are answering — <strong>claim it · chase it · pay it · fix it</strong>.
      Scope: open, unpaid, excluding credit memos.
      Context: <span data-kpi-sub="scope">{kpi.openInvoices.toLocaleString()} open invoices · {kpi.paidInvoices.toLocaleString()} paid/closed · {kpi.creditMemosOpen.toLocaleString()} credit memos open</span>.
      Use the <strong>To&nbsp;audit / Due&nbsp;now / All</strong> switch above to change scope.</p>
    <div class="iv-kpis">
      {/* ── 1 · CLAIM IT — money we are owed but have not asked for ───────────── */}
      <div class="iv-kpi iv-acc-claim">
        <span class="iv-kpi-lab">1 · Claim it — owed but not yet asked for</span>
        <span class="iv-kpi-val" data-kpi-val="cm">{money(kpi.cmApprovedTotal + kpi.cmDraftTotal)}</span>
        <span class="iv-kpi-sub" data-kpi-sub="cm">{kpi.cmApprovedCount} approved ({money(kpi.cmApprovedTotal)}) · {kpi.cmDraftCount} draft ({money(kpi.cmDraftTotal)})</span>
        <span class="iv-kpi-sub"><span data-kpi-val="claims">{kpi.claimsUnreviewed.toLocaleString()}</span> claim lines to review · <span data-kpi-sub="claims">of {kpi.claimsTotal.toLocaleString()} claim lines · {money(kpi.atRisk)} at risk</span></span>
        <div class="iv-cm-vendors" data-kpi-vendors>
          {kpi.cmByVendor.map((v) => {
            if (v.cmStatus === "coming_soon")
              return <span class="iv-process-btn iv-secondary iv-vendor-off" title="Coming Soon">{v.acronym}</span>;
            if (v.count === 0)
              return <span class="iv-process-btn iv-secondary iv-vendor-off" title={`No ${v.label} request is drafted or approved — nothing to send`}>{v.acronym}</span>;
            return (
              <a class="iv-process-btn iv-secondary" href={`/accounting/credit-memos/weekly?vendor=${encodeURIComponent(v.slug)}`}
                title={`Open the ${v.label} credit memo email + downloads in Weekly CM`}>{v.acronym} →</a>
            );
          })}
        </div>
        <div class="iv-btnrow">
          <a class="iv-process-btn iv-secondary" href="/accounting/credit-memos/weekly" title="Review claim lines on the weekly credit-memo page">Review in Weekly CM</a>
          {/* Empty is the NORMAL resting state: invoices only enter 'invoice_audit_pending'
              when a re-audit or a "Go back" reset produces fresh claim lines. */}
          <button type="button" class:list={["iv-process-btn", auditPendingCount === 0 && "is-disabled"]} id="iv-process" data-count={auditPendingCount} disabled={auditPendingCount === 0}
            title={auditPendingCount === 0
              ? "Nothing awaiting a stamp — invoices enter this queue only when a re-audit or a “Go back” reset produces new claim lines."
              : "Stamp audited invoices Invoice Audit Complete (auto-fires when a vendor email is marked sent)"}>
            <span data-kpi-empty hidden={auditPendingCount !== 0}>Nothing to stamp</span>
            <span data-kpi-full hidden={auditPendingCount === 0}>Process <span data-kpi-val="auditPending">{auditPendingCount.toLocaleString()}</span></span>
          </button>
        </div>
      </div>

      {/* ── 2 · CHASE IT — asked for, not yet credited ────────────────────────── */}
      <div class="iv-kpi iv-acc-chase">
        <span class="iv-kpi-lab">2 · Chase it — asked for, not yet credited</span>
        {/* The refresh script REPLACES the innerHTML of [data-kpi-sub="awaiting"], so the
            count must live outside it or it gets wiped on the first poll. */}
        <span class="iv-kpi-val" data-kpi-val="awaiting">{kpi.awaitingCount.toLocaleString()}</span>
        <span class="iv-kpi-sub" data-kpi-sub="awaiting">{money(kpi.awaitingTotal)} sent · <span class:list={[kpi.awaitingOverdue > 0 && "iv-overdue"]} data-kpi-overdue>{kpi.awaitingOverdue}</span> overdue (+14d)</span>
        <div class="iv-btnrow">
          <a class="iv-process-btn iv-secondary" href="/accounting/credit-memos/sent" title="The sent credit-memo workspace — every request already with a vendor, awaiting credit">Chase in Sent CM</a>
        </div>
      </div>

      {/* ── 3 · PAY IT — the three-step payment loop, in order ────────────────── */}
      <div class="iv-kpi iv-acc-pay">
        <span class="iv-kpi-lab">3 · Pay it — due → verify → export</span>
        <span class="iv-kpi-val iv-kpi-flow">
          <span data-kpi-val="dueNow">{kpi.dueNow.toLocaleString()}</span>
          <span class="iv-flow-arrow" aria-hidden="true">→</span>
          <span data-kpi-val="verify">{kpi.pendingVerification.toLocaleString()}</span>
          <span class="iv-flow-arrow" aria-hidden="true">→</span>
          <span data-kpi-val="qb">{kpi.qbPendingTotal.toLocaleString()}</span>
        </span>
        <span class="iv-kpi-sub">due now (invoice + 60d) → paid, awaiting verification → awaiting QB export</span>
        <span class="iv-kpi-sub" data-kpi-sub="qb">{kpi.qbPendingByVendor.length ? kpi.qbPendingByVendor.map((r) => `${r.slug} ${r.pending}`).join(" · ") : "all ledgers exported"}</span>
        <div class="iv-btnrow">
          <button type="button" class="iv-process-btn iv-secondary" id="iv-kpi-duenow" title="Filter the tree to payment-due invoices">Filter ↓</button>
          <button type="button" class="iv-process-btn iv-secondary" id="iv-payments" title="Open the payments panel — verify paid invoices against the AR report">Manage</button>
          {kpi.qbPendingTotal > 0
            ? <a class="iv-process-btn iv-secondary" data-kpi-btn="qb" href="/accounting/qb-bank-export" title="Preview + download the per-vendor QB bank CSVs">Export</a>
            : <span class="iv-process-btn iv-secondary iv-vendor-off" data-kpi-btn="qb" title="Every vendor ledger is already exported — nothing to export">Export</span>}
        </div>
      </div>

      {/* ── 4 · FIX IT — why the audit cannot price a line ────────────────────── */}
      <div class="iv-kpi iv-acc-fix">
        <span class="iv-kpi-lab">4 · Fix it — why a line cannot be priced</span>
        <span class="iv-kpi-val" data-kpi-val="alex">{kpi.alexCandidates.toLocaleString()}</span>
        <span class="iv-kpi-sub" data-kpi-sub="alex">repeat-purchase items → global product file · Alex auto-clears the rest</span>
        <span class="iv-kpi-sub">Data coverage, not a work queue — every gap here is a line the audit had no price to compare against.</span>
        <div class="iv-btnrow">
          {kpi.alexCandidates > 0
            ? <a class="iv-process-btn iv-secondary" href="/accounting/price-agreement/builder#agreement-gaps" title="Review the repeat-purchase candidates in the Agreement Builder">Review in Agreement Builder</a>
            : <span class="iv-process-btn iv-secondary iv-vendor-off" title="No repeat-purchase candidates are queued — nothing to review">Review in Agreement Builder</span>}
        </div>
      </div>
    </div>

    {data.totals.invoices === 0 && <p class="iv-empty">No invoices found in the live pipeline.</p>}
    {/* The tree had no empty state, so a filter that matched nothing rendered a blank
        page that read as broken. "To audit" legitimately empties out once every open
        invoice has been audited — say that instead of showing nothing. */}
    <p class="iv-empty" id="iv-noresults" hidden></p>
    <div id="iv-tree"></div>
  </section>

  <script type="application/json" id="iv-data" set:html={payload}></script>
  <div class="ia-toast" id="iv-toast" role="status" aria-live="polite"></div>
</AppShell>

<style is:global>
  .iv{
    --bg:#f4f6f9; --panel:#ffffff; --panel2:#f7f8fb; --ink:#1c2733; --muted:#6b7886; --line:#e3e8ef;
    --brand:#5b46d8; --brand-bg:#efecfd; --green:#137a4d; --green-bg:#e3f5ec; --yellow:#946400; --yellow-bg:#fbf0d4;
    --orange:#a4480d; --orange-bg:#fbe7d6; --red:#a51f1f; --red-bg:#fbe2e2; --grey:#5a6573; --grey-bg:#eceff4; --shadow:0 6px 18px rgba(20,28,40,.08);
    /* Full-bleed panel: the horizontal bleed MUST equal `.app-main main` horizontal padding
       (28px) so the panel reaches the column edges exactly — bleeding more pushed it under the
       left nav and past the right edge (client report 2026-06-28). Re-pad by the same amount. */
    --iv-bleed:28px;
    background:var(--bg); color:var(--ink);
    margin:calc(-1 * var(--space-4, 16px)) calc(-1 * var(--iv-bleed)) calc(-1 * var(--space-6, 24px));
    padding:18px var(--iv-bleed) 30px; min-height:70vh; font-family:var(--font-sans, Inter, system-ui, sans-serif);
    overflow-x:clip; /* a wider-than-column table scrolls its own wrapper, never the page/nav */
  }
  .iv[data-theme="dark"]{
    --bg:#0f141b; --panel:#161d27; --panel2:#1c2530; --ink:#e6edf5; --muted:#8b98a8; --line:#27313e;
    --brand:#8a7bff; --brand-bg:#21243f; --green:#7ee2ad; --green-bg:#123626; --yellow:#f2cf6b; --yellow-bg:#3a3115;
    --orange:#f3a766; --orange-bg:#3d2913; --red:#ff8585; --red-bg:#3d1a1a; --grey:#9aa6b4; --grey-bg:#222c38; --shadow:0 6px 18px rgba(0,0,0,.4);
  }
  .iv .pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:600;white-space:nowrap;line-height:1.5}
  .iv .pill-green{background:var(--green-bg);color:var(--green)}
  .iv .pill-yellow{background:var(--yellow-bg);color:var(--yellow)}
  .iv .pill-orange{background:var(--orange-bg);color:var(--orange)}
  .iv .pill-red{background:var(--red-bg);color:var(--red)}
  .iv .pill-grey{background:var(--grey-bg);color:var(--grey)}
  .iv .pill-brand{background:var(--brand-bg);color:var(--brand)}
  .iv .pill-pay{display:inline-flex;align-items:center;gap:5px;background:var(--green-bg);color:var(--green)}
  .iv .pill-pay input{width:13px;height:13px;margin:0;accent-color:var(--green)}

  .iv-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}
  .iv-input,.iv-select{background:var(--panel);border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:8px 11px;font-size:13px;font-family:inherit}
  .iv-input{min-width:240px}
  .iv-spacer{flex:1}
  .iv-count{font-size:12px;color:var(--muted)}
  .iv-empty{color:var(--muted);font-size:13px;padding:14px 4px}
  .iv-theme{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:var(--panel)}
  .iv-theme button{appearance:none;border:none;background:transparent;color:var(--muted);font-size:12px;font-weight:600;padding:7px 12px;cursor:pointer;font-family:inherit}
  .iv-theme button.is-active{background:var(--brand);color:#fff}

  .iv-toggle{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:600;cursor:pointer}

  /* One scope switch replaces the Show all / To-audit only / Due now checkbox trio. */
  .iv-scope{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:var(--panel)}
  .iv-scope button{appearance:none;border:none;border-right:1px solid var(--line);background:transparent;color:var(--muted);
    font-size:12.5px;font-weight:650;padding:8px 13px;cursor:pointer;font-family:inherit;white-space:nowrap}
  .iv-scope button:last-child{border-right:none}
  .iv-scope button.is-active{background:var(--brand);color:#fff}
  .iv-scope button:hover:not(.is-active){background:var(--brand-bg);color:var(--brand)}

  /* Date range + tolerance live behind a disclosure — real controls, just not the
     first thing competing for attention. */
  .iv-more{position:relative}
  .iv-more>summary{list-style:none;cursor:pointer;background:var(--panel);border:1px solid var(--line);border-radius:8px;
    padding:8px 11px;font-size:12.5px;font-weight:650;color:var(--muted);white-space:nowrap}
  .iv-more>summary::-webkit-details-marker{display:none}
  .iv-more>summary::after{content:" ▾"}
  .iv-more[open]>summary{background:var(--brand-bg);color:var(--brand);border-color:var(--brand)}
  .iv-more-body{position:absolute;z-index:20;top:calc(100% + 6px);left:0;display:flex;align-items:center;gap:10px;flex-wrap:wrap;
    background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:12px;box-shadow:var(--shadow)}
  .iv-daterange{display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--muted);font-weight:600}
  .iv-daterange-lab{white-space:nowrap}
  .iv-daterange-sep{color:var(--muted)}
  .iv-date{background:var(--panel);border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:7px 9px;font-size:12px;font-family:inherit}
  .iv-kpis-scope{font-size:12px;color:var(--muted);margin:0 0 8px}
  .iv-kpis-scope strong{color:var(--text)}
  .iv-kpis{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}
  .iv-kpi-off{opacity:.62}
  .iv-overdue{color:var(--red);font-weight:700}
  .iv-kpi{display:flex;flex-direction:column;gap:3px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px 15px}
  .iv-kpi-lab{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);font-weight:600}
  /* Each card carries its own left edge so the four groups read apart at a glance. */
  .iv-acc-claim{border-left:3px solid var(--brand)}
  .iv-acc-chase{border-left:3px solid var(--yellow)}
  .iv-acc-pay{border-left:3px solid var(--green)}
  .iv-acc-fix{border-left:3px solid var(--grey)}
  .iv-btnrow{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
  .iv-btnrow .iv-process-btn{margin-top:0}
  /* 51 → 32 → 3 is a pipeline with a direction, not three unrelated backlogs. */
  .iv-kpi-flow{display:inline-flex;align-items:baseline;gap:7px}
  .iv-flow-arrow{font-size:14px;color:var(--muted);font-weight:600}
  .iv-kpi-val{font-size:22px;font-weight:750;font-variant-numeric:tabular-nums}
  .iv-kpi-sub{font-size:11px;color:var(--muted)}
  .iv-process-btn{align-self:flex-start;margin-top:6px;border:1px solid var(--brand);background:var(--brand);color:#fff;border-radius:8px;padding:7px 11px;font-size:12px;font-weight:750;text-decoration:none;cursor:pointer;font-family:inherit}
  .iv-process-btn.is-disabled,.iv-process-btn:disabled{pointer-events:none;opacity:.45;filter:grayscale(.2)}
  .iv-process-btn.iv-secondary{background:var(--panel);color:var(--brand)}
  /* Multi-vendor CM pill (docs/88): one button per CM_VENDORS entry. iv-vendor-off
     looks disabled but keeps pointer events so the title tooltip still shows. */
  .iv-cm-vendors{display:flex;gap:6px;flex-wrap:wrap;margin-top:6px}
  .iv-cm-vendors .iv-process-btn{margin-top:0}
  .iv-vendor-off{opacity:.45;filter:grayscale(.35);cursor:not-allowed}
  .iv-pay-batch{border:1px solid var(--line);border-radius:10px;padding:10px 12px;margin-bottom:8px;background:var(--panel2)}
  .iv-pay-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .iv-pay-row strong{font-size:13px}
  .iv-pay-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
  .iv-pay-actions button,.iv-pay-actions a{appearance:none;border:1px solid var(--line);border-radius:8px;padding:5px 9px;font-size:11.5px;font-weight:700;cursor:pointer;background:var(--panel);color:var(--ink);text-decoration:none;font-family:inherit}
  .iv-pay-actions .is-paid{color:var(--green);border-color:color-mix(in srgb, var(--green) 35%, var(--line))}
  .iv-pay-actions .is-return{color:var(--red);border-color:color-mix(in srgb, var(--red) 35%, var(--line))}
  .iv-pay-sec-title{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);font-weight:700;margin:14px 0 6px}
  .iv-pay-exc{border:1px solid color-mix(in srgb, var(--red) 30%, var(--line));border-radius:9px;padding:8px 11px;margin-bottom:6px;font-size:12px}
  .iv-pay-empty{color:var(--muted);font-size:12.5px;padding:8px 2px}

  .iv-office{background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden}
  .iv-office>summary{display:flex;align-items:center;gap:14px;padding:14px 16px;cursor:pointer;list-style:none}
  .iv-office>summary::-webkit-details-marker{display:none}
  .iv-chev{color:var(--muted);transition:transform .15s;font-size:15px}
  details[open]>summary .iv-chev{transform:rotate(90deg)}
  .iv-office-name{font-weight:750;font-size:15px;flex:1}
  .iv-mini{display:flex;gap:16px}
  /* Audited-progress bar shown at every nesting level (office/branch/invoice/category). */
  .iv-bar{display:inline-flex;align-items:center;width:74px;height:6px;border-radius:999px;background:var(--line);overflow:hidden;flex:none;margin-left:10px}
  .iv-office>summary .iv-bar,.iv-branch>summary .iv-bar{width:90px}
  .iv-bar-fill{display:block;height:100%;width:0;background:var(--brand);border-radius:999px;transition:width .2s}
  .iv-bar.is-complete .iv-bar-fill{background:var(--green)}
  .iv-cat>summary .iv-bar{margin-left:8px}
  .iv-mini div{text-align:center}
  .iv-mini strong{display:block;font-size:15px;font-weight:750;font-variant-numeric:tabular-nums}
  .iv-mini span{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
  .iv-office-body{padding:4px 12px 12px;border-top:1px solid var(--line)}

  .iv-branch{border:1px solid var(--line);border-radius:11px;margin:10px 0;background:var(--panel2)}
  .iv-branch>summary{display:flex;align-items:center;gap:12px;padding:11px 13px;cursor:pointer;list-style:none;flex-wrap:wrap}
  .iv-branch>summary::-webkit-details-marker{display:none}
  .iv-branch-name{font-weight:700;font-size:13.5px}
  .iv-branch-tags{margin-left:auto;display:flex;gap:6px;flex-wrap:wrap}
