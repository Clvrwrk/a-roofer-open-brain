---
import AppShell from "../../layouts/AppShell.astro";
import { loadFridayWipBoard } from "@lib/friday-wip";

// Friday WIP/AR live board (docs/85) — the workbook's 11_Friday_Meeting sheet
// as a living surface. Data: wip_ar_master (mig 215), rebuilt nightly from the
// AccuLynx mirror + QBO job costs; the yellow columns (expected dates,
// collected?, notes) save inline and survive every refresh.
const board = await loadFridayWipBoard();
const k = board.kpis;
const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
const pct = (n: number) => Math.round(n * 100) + "%";
const runtimeTone = board.status === "live" ? "ready" : "watch";
const runtimeLabel = board.status === "live" ? "Supabase live" : "Supabase pending";
const generatedAt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }).format(new Date(board.generatedAt));
const today = new Date().toISOString().slice(0, 10);
const statusClass = (s: string) =>
  s === "Critical AR" ? "fw-status-critical" : s === "Collected in Full" ? "fw-status-full" : s === "Invoiced" ? "fw-status-invoiced" : "fw-status-pending";
---

<AppShell title="Friday WIP/AR" eyebrow="Accounting" activePage="accounting">
  <section class="fw">
    <div class="fw-toolbar">
      <h2 class="fw-title">Friday AR Meeting board</h2>
      <span class="fw-sub">Set expected cash dates · review hit/miss next week · 3-week cash map</span>
      <span class="fw-spacer"></span>
      <a class="fw-btn" href="/api/accounting/friday-wip/pack" title="Latest Thursday Excel pack (built Thursday mornings)">Download Thursday pack</a>
      <a class="fw-btn" href={`/api/accounting/friday-wip/accrual.csv?cutoff=${today}`} title="Per-job billed-to-date + costs-incurred-to-date at a cutoff, for the CPA's earned-revenue calc">Accrual snapshot CSV</a>
      <button class="fw-btn fw-btn-primary" id="fw-send" type="button" title="Maya emails the summary + pack link to the internal distribution (Lucinda / Chandler / Tabitha / Chris)">Email via Maya</button>
      <span class="runtime-pill" data-tone={runtimeTone}><span class="signal-dot" aria-hidden="true"></span>{runtimeLabel}</span>
      <span class="fw-count">{generatedAt}</span>
    </div>

    {board.error && <p class="fw-error">{board.error}</p>}

    <div class="fw-kpis">
      <div class="fw-kpi"><span class="fw-kpi-lab">Billed AR (bankable)</span><span class="fw-kpi-val">{money(k.billedAr)}</span><span class="fw-kpi-sub">open balance on issued invoices</span></div>
      <div class="fw-kpi"><span class="fw-kpi-lab">Unbilled contract</span><span class="fw-kpi-val">{money(k.unbilled)}</span><span class="fw-kpi-sub">approved work never invoiced — backlog, not AR</span></div>
      <div class="fw-kpi"><span class="fw-kpi-lab">Total job balance</span><span class="fw-kpi-val">{money(k.totalBalance)}</span><span class="fw-kpi-sub">{k.ledgerJobs} jobs on the ledger</span></div>
      <div class="fw-kpi"><span class="fw-kpi-lab">Critical AR — Tier 1</span><span class="fw-kpi-val">{money(k.criticalArTier1)}</span><span class="fw-kpi-sub">delivered · invoiced · unpaid</span></div>
      <div class="fw-kpi"><span class="fw-kpi-lab">Tier 2 — never invoiced</span><span class="fw-kpi-val">{money(k.tier2NeverInvoiced)}</span><span class="fw-kpi-sub">delivered, no invoice raised — raise it</span></div>
      <div class="fw-kpi"><span class="fw-kpi-lab">Costs incurred (QBO)</span><span class="fw-kpi-val">{money(k.costsIncurredTotal)}</span><span class="fw-kpi-sub">job-tagged bills + purchases, ledger jobs</span></div>
    </div>

    <div class="fw-cashmap">
      <span class="fw-cashmap-title">3-week cash map — billed AR only. You cannot collect what was never invoiced.</span>
      <div class="fw-cashmap-cells">
        <div class="fw-week"><span class="fw-week-lab">Week 1</span><span class="fw-week-val">{money(k.week1)}</span></div>
        <div class="fw-week"><span class="fw-week-lab">Week 2</span><span class="fw-week-val">{money(k.week2)}</span></div>
        <div class="fw-week"><span class="fw-week-lab">Week 3</span><span class="fw-week-val">{money(k.week3)}</span></div>
        <div class="fw-week"><span class="fw-week-lab">Beyond wk 3</span><span class="fw-week-val">{money(k.beyond)}</span></div>
        <div class="fw-week fw-week-warn"><span class="fw-week-lab">Billed AR, no date</span><span class="fw-week-val">{money(k.billedArNoDate)}</span><span class="fw-week-sub">unscheduled — this is the meeting's job</span></div>
        <div class="fw-week"><span class="fw-week-lab">Dated share</span><span class="fw-week-val">{pct(k.datedShare)}</span><span class="fw-week-sub">of billed AR carries a date</span></div>
      </div>
    </div>

    {board.groups.map((g) => (
      <details class="fw-group" open>
        <summary class="fw-group-head">
          <span class="fw-group-name">▸ {g.location}</span>
          <span class="fw-group-count">{g.jobs.length} jobs</span>
          <span class="fw-group-money">billed {money(g.totalBilledAr)} · unbilled {money(g.totalUnbilled)} · total {money(g.totalAr)}</span>
        </summary>
        <div class="fw-tablewrap">
          <table class="fw-table">
            <thead>
              <tr>
                <th>Job #</th><th>Client</th><th>Bucket</th><th>Rep</th>
                <th class="fw-num">Billed AR $</th><th class="fw-num">Unbilled $</th><th class="fw-num">Costs to date $</th>
                <th>Action</th><th>Status</th>
                <th class="fw-fill">Expected invoice/cash</th>
                <th class="fw-fill">Expected paid-in-full</th>
                <th>Prior (last wk)</th><th>Hit/Miss</th>
                <th class="fw-fill">Collected?</th>
                <th class="fw-fill">Notes</th>
              </tr>
            </thead>
            <tbody>
              {g.jobs.map((j) => (
                <tr data-job={j.jobId}>
                  <td>{j.acculynxUrl ? <a href={j.acculynxUrl} target="_blank" rel="noopener">{j.jobNumber || "—"}</a> : (j.jobNumber || "—")}</td>
                  <td class="fw-client" title={j.client}>{j.client}</td>
                  <td class="fw-bucket" title={j.bucket}>{j.bucket}</td>
                  <td>{j.salesperson}</td>
                  <td class="fw-num">{money(j.billedAr)}</td>
                  <td class="fw-num">{money(j.unbilled)}</td>
                  <td class="fw-num">{j.costsIncurred == null ? "—" : money(j.costsIncurred)}</td>
                  <td class={"fw-action" + (j.action === "INVOICE FIRST" ? " fw-action-invoice" : j.action === "COLLECT" ? " fw-action-collect" : "")}>{j.action}</td>
                  <td class={statusClass(j.collectionStatus)}>{j.collectionStatus}</td>
                  <td><input class="fw-edit" type="date" data-field="expected_invoice_cash_date" value={j.expectedInvoiceCashDate ?? ""} /></td>
                  <td><input class="fw-edit" type="date" data-field="expected_paid_full_date" value={j.expectedPaidFullDate ?? ""} /></td>
                  <td>{j.priorExpectedPaidDate ?? "—"}</td>
                  <td class={j.hitMiss === "HIT" ? "fw-hit" : j.hitMiss === "MISS" ? "fw-miss" : ""}>{j.hitMiss ?? ""}</td>
                  <td>
                    <select class="fw-edit" data-field="collected_since">
                      <option value="" selected={!j.collectedSince}></option>
                      <option value="Y" selected={j.collectedSince === "Y"}>Y</option>
                      <option value="N" selected={j.collectedSince === "N"}>N</option>
                    </select>
                  </td>
                  <td><input class="fw-edit fw-notes" type="text" maxlength="1000" data-field="notes" value={j.notes ?? ""} placeholder="…" /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ))}

    <p class="fw-foot">
      Yellow columns save automatically and survive the nightly rebuild. Nightly: AccuLynx sync (hourly) + ABC (3:30a) +
      QBO (Thu) → <code>refresh_wip_ar_master()</code> at ~4:45a CT. Thursday: week roll (hit/miss scored), pack build, then this board is the meeting.
    </p>
  </section>

  <style>
    .fw { display: grid; gap: 14px; }
    .fw-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .fw-title { margin: 0; font-size: 18px; }
    .fw-sub { color: var(--ink-soft, #667085); font-size: 12.5px; }
    .fw-spacer { flex: 1; }
    .fw-count { color: var(--ink-soft, #667085); font-size: 12px; }
    .fw-btn { border: 1px solid var(--line, #d0d5dd); background: var(--surface, #fff); color: inherit; border-radius: 8px; padding: 6px 12px; font-size: 12.5px; cursor: pointer; text-decoration: none; }
    .fw-btn:hover { border-color: #98a2b3; }
    .fw-btn-primary { background: #0f766e; border-color: #0f766e; color: #fff; }
    .fw-btn-primary:hover { background: #115e59; }
    .fw-btn-primary[disabled] { opacity: 0.6; cursor: wait; }
    .fw-error { color: #b42318; font-size: 13px; }
    .fw-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
    .fw-kpi { border: 1px solid var(--line, #e4e7ec); border-radius: 10px; padding: 10px 12px; display: grid; gap: 2px; background: var(--surface, #fff); }
    .fw-kpi-lab { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink-soft, #667085); }
    .fw-kpi-val { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .fw-kpi-sub { font-size: 11.5px; color: var(--ink-soft, #667085); }
    .fw-cashmap { border: 1px solid var(--line, #e4e7ec); border-radius: 10px; padding: 10px 12px; display: grid; gap: 8px; background: var(--surface, #fff); }
    .fw-cashmap-title { font-size: 12px; color: var(--ink-soft, #667085); }
    .fw-cashmap-cells { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
    .fw-week { display: grid; gap: 1px; padding: 6px 8px; border-radius: 8px; background: var(--surface-2, #f8fafc); }
    .fw-week-warn { background: #fef3c7; }
    :global([data-theme="dark"]) .fw-week-warn { background: #4d3800; }
    .fw-week-lab { font-size: 11px; color: var(--ink-soft, #667085); }
    .fw-week-val { font-weight: 700; font-variant-numeric: tabular-nums; }
    .fw-week-sub { font-size: 10.5px; color: var(--ink-soft, #667085); }
    .fw-group { border: 1px solid var(--line, #e4e7ec); border-radius: 10px; background: var(--surface, #fff); }
    .fw-group-head { display: flex; gap: 12px; align-items: baseline; padding: 10px 14px; cursor: pointer; list-style: none; }
    .fw-group-name { font-weight: 700; }
    .fw-group-count { color: var(--ink-soft, #667085); font-size: 12.5px; }
    .fw-group-money { margin-left: auto; font-size: 12.5px; font-variant-numeric: tabular-nums; color: var(--ink-soft, #475467); }
    .fw-tablewrap { overflow-x: auto; }
    .fw-table { border-collapse: collapse; width: 100%; font-size: 12.5px; }
    .fw-table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--ink-soft, #667085); padding: 6px 8px; border-top: 1px solid var(--line, #e4e7ec); border-bottom: 1px solid var(--line, #e4e7ec); white-space: nowrap; }
    .fw-table td { padding: 5px 8px; border-bottom: 1px solid var(--line-soft, #f2f4f7); vertical-align: middle; }
    .fw-table th.fw-fill { background: #fef9c3; }
    :global([data-theme="dark"]) .fw-table th.fw-fill { background: #453a00; }
    .fw-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .fw-client { max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw-bucket { max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw-action-invoice { color: #b42318; font-weight: 600; }
    .fw-action-collect { color: #0f766e; font-weight: 600; }
    .fw-status-critical { color: #b42318; font-weight: 600; }
    .fw-status-full { color: #027a48; font-weight: 600; }
    .fw-status-invoiced { color: #b54708; }
    .fw-status-pending { color: #6941c6; }
    .fw-hit { color: #027a48; font-weight: 700; }
    .fw-miss { color: #b42318; font-weight: 700; }
    .fw-edit { border: 1px solid var(--line, #d0d5dd); border-radius: 6px; padding: 3px 6px; font-size: 12px; background: #fffbeb; color: inherit; }
    :global([data-theme="dark"]) .fw-edit { background: #2a2410; }
    .fw-edit.fw-saved { border-color: #12b76a; background: #ecfdf3; }
    .fw-edit.fw-failed { border-color: #f04438; background: #fef3f2; }
    .fw-notes { min-width: 170px; }
    .fw-foot { color: var(--ink-soft, #667085); font-size: 12px; }
  </style>

  <script>
    // Inline saves: change → POST /api/accounting/friday-wip/update.
    // Green flash = persisted (survives the nightly rebuild); red = rejected.
    document.querySelectorAll<HTMLElement>(".fw-edit").forEach((el) => {
      el.addEventListener("change", async () => {
        const row = el.closest("tr");
        const jobId = row?.getAttribute("data-job");
        const field = el.getAttribute("data-field");
        if (!jobId || !field) return;
        const value = (el as HTMLInputElement | HTMLSelectElement).value;
        el.classList.remove("fw-saved", "fw-failed");
        try {
          const resp = await fetch("/api/accounting/friday-wip/update", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ jobId, field, value }),
          });
          el.classList.add(resp.ok ? "fw-saved" : "fw-failed");
          if (resp.ok) setTimeout(() => el.classList.remove("fw-saved"), 1600);
        } catch {
          el.classList.add("fw-failed");
        }
      });
    });

    // Maya send button — confirms, then POSTs; reports the outcome inline.
    const sendBtn = document.getElementById("fw-send") as HTMLButtonElement | null;
    sendBtn?.addEventListener("click", async () => {
      if (!confirm("Maya will email the WIP/AR summary + pack link to the internal distribution (Lucinda / Chandler / Tabitha / Chris). Send now?")) return;
      sendBtn.disabled = true;
      const original = sendBtn.textContent;
      sendBtn.textContent = "Sending…";
      try {
        const resp = await fetch("/api/accounting/friday-wip/send", { method: "POST" });
        const result = await resp.json().catch(() => ({}));
        if (resp.ok) {
          sendBtn.textContent = "Sent ✓";
          alert("Sent to: " + (result.to ?? []).join(", "));
        } else {
          sendBtn.textContent = original;
          alert("Send failed: " + (result.error_description ?? result.error ?? resp.status));
        }
      } catch (err) {
        sendBtn.textContent = original;
        alert("Send failed: " + err);
      } finally {
        sendBtn.disabled = false;
        setTimeout(() => { if (sendBtn.textContent === "Sent ✓") sendBtn.textContent = original; }, 4000);
      }
    });
  </script>
</AppShell>
