---
import AppShell from "../../layouts/AppShell.astro";
import { loadFridayWipBoard } from "@lib/friday-wip";

// Friday WIP/AR live board (docs/85, round 3 2026-08-06) — the workbook's
// 11_Friday_Meeting sheet as a living surface. Data: wip_ar_master (migs
// 215/216), rebuilt nightly from the AccuLynx mirror + QBO job costs; the
// yellow columns (expected dates, Estimated $, collected?, notes) save inline
// and survive every refresh. Theming shares the `cc.theme` preference with the
// other audit tabs (System/Light/Dark), zebra rows use the brand navy/gold.
const board = await loadFridayWipBoard();
const k = board.kpis;
const money = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
const pct = (n: number) => Math.round(n * 100) + "%";
const runtimeTone = board.status === "live" ? "ready" : "watch";
const runtimeLabel = board.status === "live" ? "Supabase live" : "Supabase pending";
const generatedAt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }).format(new Date(board.generatedAt));
const today = new Date().toISOString().slice(0, 10);
// Status column = AccuLynx status; ref bucket + collection status live in the tooltip.
const MILESTONE_LABELS: Record<string, string> = {
  unassigned_lead: "Lead",
  assigned_lead: "Lead",
  lead: "Lead",
  prospect: "Prospect",
  approved: "Approved",
  completed: "Completed",
  invoiced: "Invoiced",
  closed: "Closed",
};
const milestoneLabel = (m: string) => MILESTONE_LABELS[m] ?? (m ? m[0].toUpperCase() + m.slice(1) : "—");

// Days-in-status chip: green (0d) → red (365d+), clamped.
const daysChipStyle = (days: number) => {
  const t = Math.min(Math.max(days, 0), 365) / 365;
  const hue = Math.round(120 * (1 - t));
  return `background:hsl(${hue} 72% 38%);color:#fff`;
};

const reps = [...new Set(board.groups.flatMap((g) => g.jobs.map((j) => j.salesperson)))].sort((a, b) => a.localeCompare(b));
// Offices that actually have jobs on the board, with their margin basis.
const boardLocations = new Set(board.groups.map((g) => g.location));
const offices = board.offices.filter((o) => boardLocations.has(o.location));
const officeLabel = (loc: string) => loc.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());
const gmBasisLabel: Record<string, string> = {
  override: "hard-set",
  office_trailing_12mo: "office, trailing 12mo",
  company_trailing_12mo: "company avg — office sample too thin",
};
---

<AppShell title="Friday WIP/AR" eyebrow="Accounting" activePage="accounting">
  <section class="fw" id="fw" data-theme="light" data-pref="system">
    <div class="fw-toolbar">
      <h2 class="fw-title">Friday AR Meeting board</h2>
      <span class="fw-sub">Set expected cash dates · 3-week cash map</span>
      <span class="fw-spacer"></span>
      <label class="fw-filter">Office
        <select id="fw-office" class="fw-select">
          <option value="">All offices</option>
          {offices.map((o) => (
            <option
              value={o.location}
              data-gm={o.effectiveGmPct}
              data-basis={o.gmBasis}
              data-office-gm={o.gmPctOffice ?? ""}
              data-company-gm={o.gmPctCompany ?? ""}
              data-override={o.gmPctOverride ?? ""}
              data-sample-jobs={o.sampleJobs ?? ""}
              data-set-by={o.setBy ?? ""}
            >{officeLabel(o.location)} · GM {o.effectiveGmPct}%</option>
          ))}
        </select>
      </label>
      {/* Margin control appears only with an office selected — the rate is
          per-office, so there is nothing coherent to set across "All". */}
      <span class="fw-margin" id="fw-margin" hidden>
        <label class="fw-filter">GM %
          <input id="fw-margin-input" class="fw-select fw-margin-input" type="number" min="-50" max="90" step="0.1" placeholder="—" />
        </label>
        <button type="button" class="fw-btn" id="fw-margin-save">Set</button>
        <button type="button" class="fw-btn" id="fw-margin-clear" title="Clear the override and go back to the computed rate">Reset</button>
        <span class="fw-margin-note" id="fw-margin-note"></span>
      </span>
      <label class="fw-filter">Rep
        <select id="fw-rep" class="fw-select">
          <option value="">All reps</option>
          {reps.map((r) => <option value={r}>{r}</option>)}
        </select>
      </label>
      <a class="fw-btn" href="/api/accounting/friday-wip/pack" title="Latest Excel pack (published nightly to the wip-packs bucket)">Download pack</a>
      <a class="fw-btn" href={`/api/accounting/friday-wip/accrual.csv?cutoff=${today}`} title="Per-job billed-to-date + costs-incurred-to-date at a cutoff, for the CPA's earned-revenue calc">Accrual snapshot CSV</a>
      <button class="fw-btn fw-btn-primary" id="fw-send" type="button" title="Maya emails the summary + pack link to the internal distribution (Lucinda / Chandler / Tabatha / Chris)">Email via Maya</button>
      <span class="runtime-pill" data-tone={runtimeTone}><span class="signal-dot" aria-hidden="true"></span>{runtimeLabel}</span>
      <span class="fw-count">{generatedAt}</span>
      <div class="fw-theme" role="group" aria-label="Theme">
        <button type="button" data-set-theme="system" class="is-active">System</button>
        <button type="button" data-set-theme="light">Light</button>
        <button type="button" data-set-theme="dark">Dark</button>
      </div>
    </div>

    {board.error && <p class="fw-error">{board.error}</p>}

    <p class="fw-filterbar" id="fw-filterbar" hidden>
      <span id="fw-filter-label"></span>
      <button type="button" class="fw-clear" id="fw-clear">Clear filter ✕</button>
    </p>

    {/* Single popout reused by every row — one node, not one per job. */}
    <div class="fw-guess" id="fw-guess" role="dialog" aria-modal="false" aria-labelledby="fw-guess-title" hidden>
      <div class="fw-guess-head">
        <strong id="fw-guess-title"></strong>
        <button type="button" class="fw-guess-close" id="fw-guess-close" aria-label="Close">✕</button>
      </div>
      <p class="fw-guess-body" id="fw-guess-body"></p>
    </div>

    {/* Every pill is a filter. data-kpi matches the keys the loader tagged each
        row with, so clicking a pill shows exactly the rows its number was
        summed from. "Total job balance" selects every row, so it doubles as
        the clear-filter control. */}
    <div class="fw-kpis" role="group" aria-label="Filter the board by KPI">
      <button type="button" class="fw-kpi" data-kpi="billedAr" aria-pressed="false"><span class="fw-kpi-lab">Billed AR (bankable)</span><span class="fw-kpi-val">{money(k.billedAr)}</span><span class="fw-kpi-sub">open balance on issued invoices</span></button>
      <button type="button" class="fw-kpi" data-kpi="unbilled" aria-pressed="false"><span class="fw-kpi-lab">Unbilled contract</span><span class="fw-kpi-val">{money(k.unbilled)}</span><span class="fw-kpi-sub">approved work never invoiced — backlog, not AR</span></button>
      <button type="button" class="fw-kpi" data-kpi="totalBalance" aria-pressed="false"><span class="fw-kpi-lab">Total job balance</span><span class="fw-kpi-val">{money(k.totalBalance)}</span><span class="fw-kpi-sub">{k.ledgerJobs} jobs on the ledger</span></button>
      <button type="button" class="fw-kpi" data-kpi="criticalArTier1" aria-pressed="false"><span class="fw-kpi-lab">Critical AR — Tier 1</span><span class="fw-kpi-val">{money(k.criticalArTier1)}</span><span class="fw-kpi-sub">delivered · invoiced · unpaid</span></button>
      <button type="button" class="fw-kpi" data-kpi="tier2NeverInvoiced" aria-pressed="false"><span class="fw-kpi-lab">Tier 2 — never invoiced</span><span class="fw-kpi-val">{money(k.tier2NeverInvoiced)}</span><span class="fw-kpi-sub">delivered, no invoice raised — raise it</span></button>
      <button type="button" class="fw-kpi" data-kpi="costsIncurred" aria-pressed="false"><span class="fw-kpi-lab">Expense realized (QBO)</span><span class="fw-kpi-val">{money(k.costsIncurredTotal)}</span><span class="fw-kpi-sub">job-tagged bills + purchases, ledger jobs</span></button>
      <button type="button" class="fw-kpi" data-kpi="expenseOutstanding" aria-pressed="false"><span class="fw-kpi-lab">Expense outstanding</span><span class="fw-kpi-val">{money(k.expenseOutstandingTotal)}</span><span class="fw-kpi-sub">budget left to spend — est. total {money(k.estTotalCostsTotal)}</span></button>
      <button type="button" class="fw-kpi fw-kpi-warn" data-kpi="staleCloseout" aria-pressed="false"><span class="fw-kpi-lab">Stale — close in AccuLynx</span><span class="fw-kpi-val">{k.staleCloseoutJobs}</span><span class="fw-kpi-sub">paid in full, never closed · {money(k.staleCloseoutContract)} contracted</span></button>
      <button type="button" class="fw-kpi fw-kpi-warn" data-kpi="contradiction" aria-pressed="false"><span class="fw-kpi-lab">Balance contradiction</span><span class="fw-kpi-val">{k.contradictionJobs}</span><span class="fw-kpi-sub">{money(k.contradictionAr)} invoiced but not in job balance</span></button>
      <button type="button" class="fw-kpi" data-kpi="signedContract" aria-pressed="false"><span class="fw-kpi-lab">Signed contract, no AR</span><span class="fw-kpi-val">{k.signedContractJobs}</span><span class="fw-kpi-sub">work in progress, nothing invoiced yet</span></button>
    </div>

    <div class="fw-cashmap">
      <span class="fw-cashmap-title">3-week cash map — billed AR only. Estimated $ lands at its invoice/cash date; the remainder at paid-in-full. You cannot collect what was never invoiced.</span>
      <div class="fw-cashmap-cells" role="group" aria-label="Filter the board by cash week">
        <button type="button" class="fw-week" data-kpi="week1" aria-pressed="false"><span class="fw-week-lab">Week 1</span><span class="fw-week-val">{money(k.week1)}</span></button>
        <button type="button" class="fw-week" data-kpi="week2" aria-pressed="false"><span class="fw-week-lab">Week 2</span><span class="fw-week-val">{money(k.week2)}</span></button>
        <button type="button" class="fw-week" data-kpi="week3" aria-pressed="false"><span class="fw-week-lab">Week 3</span><span class="fw-week-val">{money(k.week3)}</span></button>
        <button type="button" class="fw-week" data-kpi="beyond" aria-pressed="false"><span class="fw-week-lab">Beyond wk 3</span><span class="fw-week-val">{money(k.beyond)}</span></button>
        <button type="button" class="fw-week fw-week-warn" data-kpi="billedArNoDate" aria-pressed="false"><span class="fw-week-lab">Billed AR, no date</span><span class="fw-week-val">{money(k.billedArNoDate)}</span><span class="fw-week-sub">unscheduled — this is the meeting's job</span></button>
        {/* Dated share is a ratio, not a set of rows — nothing to filter to. */}
        <div class="fw-week fw-week-static"><span class="fw-week-lab">Dated share</span><span class="fw-week-val">{pct(k.datedShare)}</span><span class="fw-week-sub">of billed AR carries a date</span></div>
      </div>
    </div>

    {board.groups.map((g) => (
      <details class="fw-group" open>
        <summary class="fw-group-head">
          <span class="fw-group-name">▸ {g.location}</span>
          <span class="fw-group-count">{g.activeJobs} jobs{g.staleJobs ? ` · ${g.staleJobs} stale` : ""}</span>
          <span class="fw-group-money">billed {money(g.totalBilledAr)} · unbilled {money(g.totalUnbilled)} · total {money(g.totalAr)}</span>
        </summary>
        <div class="fw-tablewrap">
          <table class="fw-table">
            <thead>
              <tr>
                <th>Job #</th><th>Client</th><th>Status (AccuLynx)</th><th>Rep</th>
                <th class="fw-num" title="AccuLynx approved job value (L)">Contract Total</th>
                <th class="fw-num" title="Σ non-void invoices issued (P)">Invoiced Total</th>
                <th class="fw-num" title="Invoiced − open invoice balance (R)">Monies Collected</th>
                <th class="fw-num" title="AccuLynx job balance due (N)">Balance Due</th>
                <th class="fw-num" title="QBO job-tagged bills + purchases to date">Expense Realized</th>
                <th class="fw-num" title="Budget remaining: contract × (1 − office GM%) − expense realized, floored at 0. A budgeting estimate, not a takeoff.">Expense Outstanding</th>
                <th title="Days in current AccuLynx status (green 0 → red 365+)">Days in Status</th>
                <th>Action</th>
                <th class="fw-fill">Expected invoice/cash</th>
                <th class="fw-fill" title="Cash the team expects to collect at that date">Estimated $</th>
                <th class="fw-fill">Expected paid-in-full</th>
                <th class="fw-fill">Collected?</th>
                <th class="fw-fill">Notes</th>
              </tr>
            </thead>
            <tbody>
              {g.jobs.map((j) => (
                <tr data-job={j.jobId} data-rep={j.salesperson} data-kpi={j.kpiKeys.join(" ")} data-population={j.populationReason ?? ""} data-location={j.location} data-attention={j.attentionFlag ?? ""}>
                  <td>{j.acculynxUrl ? <a href={j.acculynxUrl} target="_blank" rel="noopener">{j.jobNumber || "—"}</a> : (j.jobNumber || "—")}</td>
                  {/* The job number is already the AccuLynx deep link, so the
                      "Our Best Guess" popout hangs off the client name instead. */}
                  <td class="fw-client">
                    {j.attentionNote ? (
                      <button type="button" class="fw-guess-trigger" data-guess={j.attentionNote} data-guess-title={`${j.jobNumber} · ${j.client}`} aria-haspopup="dialog">
                        <span class="fw-guess-dot" aria-hidden="true">?</span>{j.client}
                      </button>
                    ) : (<span title={j.client}>{j.client}</span>)}
                  </td>
                  <td class="fw-bucket" title={`AccuLynx: ${milestoneLabel(j.milestone)} · ref: ${j.bucket} · ${j.collectionStatus}${j.populationReason === "signed_contract" ? " · on the board as a signed contract (no AR yet)" : ""}`}>
                    <strong>{milestoneLabel(j.milestone)}</strong>
                    {j.populationReason === "signed_contract" && <span class="fw-wip-dot" aria-label="Signed contract, no AR yet">•</span>}
                  </td>
                  <td>{j.salesperson}</td>
                  <td class="fw-num">{money(j.contractAmount)}</td>
                  <td class="fw-num">{money(j.billedTotal)}</td>
                  <td class="fw-num">{money(j.collectedRevenue)}</td>
                  <td class="fw-num">{money(j.outstandingAr)}</td>
                  <td class="fw-num">{j.costsIncurred == null ? "—" : money(j.costsIncurred)}</td>
                  <td class="fw-num" title={j.estTotalCosts == null ? "No contract value — nothing to estimate against" : `Estimated total cost ${money(j.estTotalCosts)} (${j.estCostsSource ?? ""}) − expense realized`}>{j.expenseOutstanding == null ? "—" : money(j.expenseOutstanding)}</td>
                  <td class="fw-days">{j.daysInStatus == null ? "—" : <span class="fw-days-chip" style={daysChipStyle(j.daysInStatus)}>{j.daysInStatus}d</span>}</td>
                  <td class={"fw-action" + (j.action === "INVOICE FIRST" ? " fw-action-invoice" : j.action === "COLLECT" ? " fw-action-collect" : "")}>{j.action}</td>
                  <td><input class="fw-edit" type="date" data-field="expected_invoice_cash_date" value={j.expectedInvoiceCashDate ?? ""} /></td>
                  <td><input class="fw-edit fw-money-edit" type="number" min="0" step="100" data-field="expected_cash_amount" value={j.expectedCashAmount ?? ""} placeholder="$" /></td>
                  <td><input class="fw-edit" type="date" data-field="expected_paid_full_date" value={j.expectedPaidFullDate ?? ""} /></td>
                  <td>
                    <select class="fw-edit" data-field="collected_since">
                      <option value="" selected={!j.collectedSince}></option>
                      <option value="Y" selected={j.collectedSince === "Y"}>Y</option>
                      <option value="N" selected={j.collectedSince === "N"}>N</option>
                    </select>
                  </td>
                  <td><input class="fw-edit fw-notes" type="text" maxlength="1000" data-field="notes" value={j.notes ?? ""} placeholder="…" /></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </details>
    ))}

    <p class="fw-foot">
      Yellow columns save automatically and survive the nightly rebuild. Feeds, all verified running 2026-08-21:
      AccuLynx sync hourly · QBO mirror daily 01:00 UTC · ABC mirror daily 07:30 UTC (3:30a ET) →
      <code>refresh_wip_ar_master()</code> daily 10:45 UTC (5:45a CT), pack publish 6a CT. Thursday: week roll, then this board is the meeting.
      Population: jobs carrying AR, plus signed contracts (<span class="fw-wip-dot">•</span>) — prospect/approved/completed/invoiced over $1.
    </p>
  </section>

  <style is:global>
    /* Theme variables — brand palette (navy #11133f · gold #eaa221), light
       defaults with a dark override, same mechanism + `ivTheme` preference as
       Invoice Audit so the choice carries across tabs. Zebra rows tint with
       the brand navy in light mode and lift in dark. */
    .fw {
      --bg: #f4f6f9; --panel: #ffffff; --ink: #1c2733; --muted: #6b7886; --line: #e3e8ef;
      --zebra: #f0f1f8; --navy: #11133f; --gold: #eaa221;
      --fill-bg: #fbedd2; --fill-cell: #fffbeb; --warn-bg: #fbedd2;
      --green: #137a4d; --green-bg: #e3f5ec; --red: #a51f1f; --orange: #a4480d; --purple: #5b46d8;
      --teal: #0f766e; --teal-dark: #115e59;
      --saved-bg: #ecfdf3; --saved-line: #12b76a; --failed-bg: #fef3f2; --failed-line: #f04438;
      display: grid; gap: 14px;
      background: var(--bg); color: var(--ink);
      margin: calc(-1 * var(--space-4, 16px)) -28px calc(-1 * var(--space-6, 24px));
      padding: 18px 28px 30px; min-height: 70vh;
      font-family: var(--font-sans, Inter, system-ui, sans-serif);
      overflow-x: clip;
    }
    .fw[data-theme="dark"] {
      --bg: #0f141b; --panel: #161d27; --ink: #e6edf5; --muted: #8b98a8; --line: #27313e;
      --zebra: #1a2230; --gold: #f2cf6b;
      --fill-bg: #3a3115; --fill-cell: #2a2410; --warn-bg: #4d3800;
      --green: #7ee2ad; --green-bg: #123626; --red: #ff8585; --orange: #f3a766; --purple: #8a7bff;
      --saved-bg: #123626; --saved-line: #12b76a; --failed-bg: #3d1a1a; --failed-line: #f04438;
    }
    .fw .fw-toolbar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .fw .fw-title { margin: 0; font-size: 18px; color: var(--ink); }
    .fw .fw-sub { color: var(--muted); font-size: 12.5px; }
    .fw .fw-spacer { flex: 1; }
    .fw .fw-count { color: var(--muted); font-size: 12px; }
    .fw .fw-theme { display: inline-flex; border: 1px solid var(--line); border-radius: 9px; overflow: hidden; background: var(--panel); }
    .fw .fw-theme button { appearance: none; border: none; background: transparent; color: var(--muted); font-size: 12px; font-weight: 600; padding: 7px 12px; cursor: pointer; font-family: inherit; }
    .fw .fw-theme button.is-active { background: var(--navy); color: #fff; }
    .fw .fw-filter { display: inline-flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--muted); }
    .fw .fw-select { border: 1px solid var(--line); border-radius: 8px; padding: 5px 8px; font-size: 12.5px; background: var(--panel); color: var(--ink); }
    .fw .fw-btn { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 8px; padding: 6px 12px; font-size: 12.5px; cursor: pointer; text-decoration: none; }
    .fw .fw-btn:hover { border-color: var(--muted); }
    .fw .fw-btn-primary { background: var(--teal); border-color: var(--teal); color: #fff; }
    .fw .fw-btn-primary:hover { background: var(--teal-dark); }
    .fw .fw-btn-primary[disabled] { opacity: 0.6; cursor: wait; }
    .fw .fw-error { color: var(--red); font-size: 13px; }
    .fw .fw-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(170px, 1fr)); gap: 10px; }
    /* KPI pills and cash-map cells are buttons that filter the board. They keep
       the card look; only the affordances (cursor, hover, pressed) are added. */
    .fw .fw-kpi { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: grid; gap: 2px; background: var(--panel); text-align: left; font-family: inherit; color: inherit; cursor: pointer; }
    .fw .fw-kpi:hover { border-color: var(--gold); }
    .fw .fw-kpi:focus-visible, .fw .fw-week:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
    .fw .fw-kpi[aria-pressed="true"] { border-color: var(--navy); box-shadow: inset 0 0 0 1px var(--navy); background: var(--fill-cell); }
    .fw[data-theme="dark"] .fw-kpi[aria-pressed="true"] { border-color: var(--gold); box-shadow: inset 0 0 0 1px var(--gold); }
    .fw .fw-filterbar { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 12.5px; color: var(--muted); }
    .fw .fw-clear { border: 1px solid var(--line); background: var(--panel); color: var(--ink); border-radius: 8px; padding: 3px 10px; font-size: 12px; cursor: pointer; font-family: inherit; }
    .fw .fw-clear:hover { border-color: var(--muted); }
    .fw .fw-wip-dot { color: var(--gold); font-weight: 700; margin-left: 4px; }
    .fw .fw-margin { display: inline-flex; align-items: center; gap: 6px; padding: 3px 8px; border: 1px solid var(--gold); border-radius: 9px; background: var(--fill-cell); }
    .fw .fw-margin-input { width: 78px; text-align: right; }
    .fw .fw-margin-note { font-size: 11.5px; color: var(--muted); max-width: 260px; }
    .fw .fw-margin-note[data-tone="saved"] { color: var(--green); }
    .fw .fw-margin-note[data-tone="failed"] { color: var(--red); }
    /* Filtering hides via [hidden]. Table rows carry a UA display that can
       outrank the UA [hidden] rule, so state it explicitly. */
    .fw [hidden] { display: none !important; }
    .fw .fw-kpi-warn { border-color: var(--gold); }
    /* "Our Best Guess" — hangs off the client name because the job number is
       already the AccuLynx deep link. */
    .fw .fw-guess-trigger { appearance: none; border: none; background: none; padding: 0; font: inherit; color: inherit; cursor: pointer; text-align: left; display: inline-flex; align-items: center; gap: 5px; max-width: 190px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw .fw-guess-trigger:hover { text-decoration: underline; text-decoration-color: var(--gold); }
    .fw .fw-guess-dot { flex: none; display: inline-grid; place-items: center; width: 15px; height: 15px; border-radius: 999px; background: var(--gold); color: #1c2733; font-size: 10px; font-weight: 800; }
    .fw .fw-guess { position: fixed; z-index: 50; max-width: 460px; background: var(--panel); color: var(--ink); border: 1px solid var(--gold); border-radius: 10px; box-shadow: 0 10px 34px rgba(0,0,0,0.28); padding: 12px 14px; display: grid; gap: 6px; }
    .fw .fw-guess-head { display: flex; align-items: baseline; gap: 10px; }
    .fw .fw-guess-head strong { font-size: 13px; }
    .fw .fw-guess-close { margin-left: auto; appearance: none; border: none; background: none; color: var(--muted); cursor: pointer; font-size: 13px; padding: 0 2px; }
    .fw .fw-guess-body { margin: 0; font-size: 12.5px; line-height: 1.5; color: var(--ink); }
    .fw .fw-kpi-lab { font-size: 11px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--muted); }
    .fw .fw-kpi-val { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .fw .fw-kpi-sub { font-size: 11.5px; color: var(--muted); }
    .fw .fw-cashmap { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; display: grid; gap: 8px; background: var(--panel); }
    .fw .fw-cashmap-title { font-size: 12px; color: var(--muted); }
    .fw .fw-cashmap-cells { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 8px; }
    .fw .fw-week { display: grid; gap: 1px; padding: 6px 8px; border-radius: 8px; background: var(--zebra); border: 1px solid transparent; text-align: left; font-family: inherit; color: inherit; font-size: 12.5px; cursor: pointer; }
    .fw .fw-week-static { cursor: default; }
    button.fw-week:hover { border-color: var(--gold); }
    .fw .fw-week[aria-pressed="true"] { border-color: var(--navy); background: var(--fill-cell); }
    .fw[data-theme="dark"] .fw-week[aria-pressed="true"] { border-color: var(--gold); }
    .fw .fw-week-warn { background: var(--warn-bg); }
    .fw .fw-week-lab { font-size: 11px; color: var(--muted); }
    .fw .fw-week-val { font-weight: 700; font-variant-numeric: tabular-nums; }
    .fw .fw-week-sub { font-size: 10.5px; color: var(--muted); }
    .fw .fw-group { border: 1px solid var(--line); border-radius: 10px; background: var(--panel); min-width: 0; }
    .fw .fw-group-head { display: flex; gap: 12px; align-items: baseline; padding: 10px 14px; cursor: pointer; list-style: none; border-left: 3px solid var(--gold); border-radius: 10px 0 0 10px; }
    .fw .fw-group-name { font-weight: 700; }
    .fw .fw-group-count { color: var(--muted); font-size: 12.5px; }
    .fw .fw-group-money { margin-left: auto; font-size: 12.5px; font-variant-numeric: tabular-nums; color: var(--muted); }
    /* Expanded office = a fixed 70vh spreadsheet pane: rows scroll vertically,
       the yellow columns scroll horizontally, the header row and the first two
       columns (Job # · Client) stay frozen. Sticky cells need border-collapse:
       separate (collapsed borders don't travel with sticky cells) and their own
       opaque backgrounds, so zebra/hover paint on td, not tr. */
    .fw .fw-tablewrap { overflow: auto; max-height: 70vh; }
    .fw .fw-table { border-collapse: separate; border-spacing: 0; width: 100%; font-size: 12.5px; }
    .fw .fw-table th { text-align: left; font-size: 11px; text-transform: uppercase; letter-spacing: 0.03em; color: var(--muted); padding: 6px 8px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); white-space: nowrap; }
    .fw .fw-table td { padding: 5px 8px; border-bottom: 1px solid var(--line); vertical-align: middle; }
    .fw .fw-table thead th { position: sticky; top: 0; z-index: 3; background: var(--panel); }
    .fw .fw-table th:nth-child(-n + 2), .fw .fw-table td:nth-child(-n + 2) { position: sticky; z-index: 2; background: var(--panel); }
    .fw .fw-table th:nth-child(1), .fw .fw-table td:nth-child(1) { left: 0; width: 72px; min-width: 72px; max-width: 72px; white-space: nowrap; }
    .fw .fw-table th:nth-child(2), .fw .fw-table td:nth-child(2) { left: 72px; box-shadow: 6px 0 8px -6px rgba(0, 0, 0, 0.28); }
    .fw .fw-table thead th:nth-child(-n + 2) { z-index: 4; }
    .fw .fw-table tbody tr:nth-child(even) td { background: var(--zebra); }
    .fw .fw-table tbody tr:hover td { background: var(--fill-bg); }
    .fw .fw-table th.fw-fill { background: var(--fill-bg); }
    .fw .fw-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .fw .fw-client { max-width: 200px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw .fw-bucket { max-width: 230px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .fw .fw-days { text-align: center; }
    .fw .fw-days-chip { display: inline-block; min-width: 40px; text-align: center; border-radius: 999px; padding: 2px 8px; font-weight: 700; font-size: 11.5px; font-variant-numeric: tabular-nums; }
    .fw .fw-action-invoice { color: var(--red); font-weight: 600; }
    .fw .fw-action-collect { color: var(--teal); font-weight: 600; }
    .fw[data-theme="dark"] .fw-action-collect { color: var(--green); }
    .fw .fw-edit { border: 1px solid var(--line); border-radius: 6px; padding: 3px 6px; font-size: 12px; background: var(--fill-cell); color: var(--ink); }
    .fw .fw-edit.fw-saved { border-color: var(--saved-line); background: var(--saved-bg); }
    .fw .fw-edit.fw-failed { border-color: var(--failed-line); background: var(--failed-bg); }
    .fw .fw-money-edit { width: 96px; text-align: right; }
    .fw .fw-notes { min-width: 150px; }
    .fw .fw-foot { color: var(--muted); font-size: 12px; }
    .fw a { color: inherit; text-decoration: underline; text-decoration-color: var(--muted); }
  </style>

  <script>
    import { initThemePref } from "../../scripts/theme-pref";

    // Theme toggle — shared preference across every audit surface.
    // See src/scripts/theme-pref.ts.
    const fwRoot = document.getElementById("fw")!;
    initThemePref(fwRoot, ".fw-theme button");

    // Inline saves: change → POST /api/accounting/friday-wip/update.
    // Green flash = persisted (survives the nightly rebuild); red = rejected.
    document.querySelectorAll<HTMLElement>(".fw-edit").forEach((el) => {
      el.addEventListener("change", async () => {
        const row = el.closest("tr");
        const jobId = row?.getAttribute("data-job");
        const field = el.getAttribute("data-field");
        if (!jobId || !field) return;
        const value = (el as HTMLInputElement | HTMLSelectElement).value;
        el.classList.remove("fw-saved", "fw-failed");
        try {
          const resp = await fetch("/api/accounting/friday-wip/update", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: JSON.stringify({ jobId, field, value }),
          });
          el.classList.add(resp.ok ? "fw-saved" : "fw-failed");
          if (resp.ok) setTimeout(() => el.classList.remove("fw-saved"), 1600);
        } catch {
          el.classList.add("fw-failed");
        }
      });
    });

    // ── Filtering ────────────────────────────────────────────────────────
    // Two independent filters — rep and KPI — resolved in ONE pass so they
    // compose. A row is visible when it satisfies both. Visibility is a class
    // rather than an inline style so counting visible rows never has to parse
    // a style attribute.
    const repSelect = document.getElementById("fw-rep") as HTMLSelectElement | null;
    const filterBar = document.getElementById("fw-filterbar") as HTMLElement | null;
    const filterLabel = document.getElementById("fw-filter-label") as HTMLElement | null;
    const clearBtn = document.getElementById("fw-clear") as HTMLButtonElement | null;
    const officeSelect = document.getElementById("fw-office") as HTMLSelectElement | null;
    const kpiButtons = Array.from(
      document.querySelectorAll<HTMLButtonElement>("button.fw-kpi[data-kpi], button.fw-week[data-kpi]"),
    );

    let activeKpi: string | null = null;

    const applyFilters = () => {
      const rep = repSelect?.value ?? "";
      const office = officeSelect?.value ?? "";
      let shown = 0;

      document.querySelectorAll<HTMLTableRowElement>("tr[data-job]").forEach((row) => {
        const repOk = !rep || row.getAttribute("data-rep") === rep;
        const officeOk = !office || row.getAttribute("data-location") === office;
        const kpiOk =
          !activeKpi || (row.getAttribute("data-kpi") ?? "").split(" ").includes(activeKpi);
        // Stale close-outs are off the working board by default. They are
        // finished, paid work — an AccuLynx housekeeping list — and are
        // reachable only through their own pill.
        const stale = row.getAttribute("data-attention") === "stale_closeout";
        const staleOk = activeKpi === "staleCloseout" ? stale : !stale;
        const visible = repOk && officeOk && kpiOk && staleOk;
        row.hidden = !visible;
        if (visible) shown += 1;
      });

      // Collapse location groups that have nothing left in them, and re-open
      // the ones that do — a filtered-to-empty group is noise.
      document.querySelectorAll<HTMLElement>(".fw-group").forEach((group) => {
        const visible = group.querySelectorAll<HTMLTableRowElement>("tr[data-job]:not([hidden])").length;
        group.hidden = visible === 0;
      });

      kpiButtons.forEach((b) => {
        b.setAttribute("aria-pressed", String(b.dataset.kpi === activeKpi));
      });

      const active = activeKpi ? kpiButtons.find((b) => b.dataset.kpi === activeKpi) : null;
      const name = active?.querySelector(".fw-kpi-lab, .fw-week-lab")?.textContent?.trim() ?? "";
      if (activeKpi || rep || office) {
        if (filterLabel) {
          const parts = [
            activeKpi ? `KPI: ${name}` : null,
            office ? `Office: ${office.replace(/_/g, " ")}` : null,
            rep ? `Rep: ${rep}` : null,
          ].filter(Boolean);
          filterLabel.textContent = `${parts.join(" · ")} — ${shown} job${shown === 1 ? "" : "s"}`;
        }
        filterBar?.removeAttribute("hidden");
      } else {
        filterBar?.setAttribute("hidden", "");
      }
    };

    repSelect?.addEventListener("change", applyFilters);

    // ── Per-office gross margin (mig 260) ────────────────────────────────
    // The margin drives Estimated total expense for every job in the office,
    // so the control shows what the current rate rests on before it is
    // changed — a rate carried by 1 job reads very differently from 107.
    const marginBox = document.getElementById("fw-margin") as HTMLElement | null;
    const marginInput = document.getElementById("fw-margin-input") as HTMLInputElement | null;
    const marginNote = document.getElementById("fw-margin-note") as HTMLElement | null;
    const marginSave = document.getElementById("fw-margin-save") as HTMLButtonElement | null;
    const marginClear = document.getElementById("fw-margin-clear") as HTMLButtonElement | null;
    const BASIS_LABEL: Record<string, string> = {
      override: "hard-set",
      office_trailing_12mo: "office, trailing 12mo",
      company_trailing_12mo: "company avg — office sample too thin",
    };

    const syncMarginBox = () => {
      const opt = officeSelect?.selectedOptions?.[0];
      if (!officeSelect?.value || !opt) {
        marginBox?.setAttribute("hidden", "");
        return;
      }
      marginBox?.removeAttribute("hidden");
      if (marginInput) marginInput.value = opt.dataset.gm ?? "";
      if (marginNote) {
        const basis = BASIS_LABEL[opt.dataset.basis ?? ""] ?? (opt.dataset.basis ?? "");
        const jobs = opt.dataset.sampleJobs;
        const by = opt.dataset.setBy;
        marginNote.removeAttribute("data-tone");
        marginNote.textContent =
          `${basis}${jobs ? ` · ${jobs} completed job${jobs === "1" ? "" : "s"}` : ""}${by ? ` · set by ${by}` : ""}`;
      }
    };

    officeSelect?.addEventListener("change", () => { syncMarginBox(); applyFilters(); });

    const postMargin = async (gmPct: string | null) => {
      const location = officeSelect?.value;
      if (!location) return;
      if (marginNote) { marginNote.removeAttribute("data-tone"); marginNote.textContent = "Saving…"; }
      if (marginSave) marginSave.disabled = true;
      try {
        const resp = await fetch("/api/accounting/friday-wip/margin", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ location, gmPct }),
        });
        const result = await resp.json().catch(() => ({}));
        if (!resp.ok) {
          if (marginNote) {
            marginNote.setAttribute("data-tone", "failed");
            marginNote.textContent = result.error_description ?? result.error ?? `Failed (${resp.status})`;
          }
          return;
        }
        // The estimates for every job in this office just changed, so the
        // page is stale — reload rather than patch cells one by one.
        if (marginNote) { marginNote.setAttribute("data-tone", "saved"); marginNote.textContent = "Saved — reloading…"; }
        window.location.reload();
      } catch (err) {
        if (marginNote) { marginNote.setAttribute("data-tone", "failed"); marginNote.textContent = String(err); }
      } finally {
        if (marginSave) marginSave.disabled = false;
      }
    };

    marginSave?.addEventListener("click", () => postMargin(marginInput?.value ?? null));
    marginClear?.addEventListener("click", () => postMargin(null));
    syncMarginBox();

    // Run once at load: the default view is "not stale", and without this the
    // 225 stale close-outs render until the first filter event fires.
    applyFilters();

    kpiButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        // Clicking the active pill clears it, so a pill is a toggle rather
        // than a mode you have to escape from.
        activeKpi = activeKpi === btn.dataset.kpi ? null : (btn.dataset.kpi ?? null);
        applyFilters();
      });
    });

    clearBtn?.addEventListener("click", () => {
      activeKpi = null;
      if (repSelect) repSelect.value = "";
      if (officeSelect) officeSelect.value = "";
      syncMarginBox();
      applyFilters();
    });

    // ── "Our Best Guess" popout ──────────────────────────────────────────
    // One dialog node reused by every row. Positioned next to whichever
    // client name was clicked, clamped into the viewport.
    const guess = document.getElementById("fw-guess") as HTMLElement | null;
    const guessTitle = document.getElementById("fw-guess-title") as HTMLElement | null;
    const guessBody = document.getElementById("fw-guess-body") as HTMLElement | null;
    const closeGuess = () => guess?.setAttribute("hidden", "");

    document.querySelectorAll<HTMLButtonElement>(".fw-guess-trigger").forEach((trigger) => {
      trigger.addEventListener("click", (event) => {
        event.stopPropagation();
        if (!guess || !guessTitle || !guessBody) return;
        guessTitle.textContent = trigger.dataset.guessTitle ?? "Our Best Guess";
        guessBody.textContent = trigger.dataset.guess ?? "";
        guess.removeAttribute("hidden");
        const r = trigger.getBoundingClientRect();
        const w = guess.offsetWidth;
        const h = guess.offsetHeight;
        // The dialog is position:fixed, so these are viewport coordinates —
        // clamp BOTH axes or a row near an edge puts the popout off-screen.
        guess.style.left = Math.max(8, Math.min(r.left, window.innerWidth - w - 8)) + "px";
        const below = r.bottom + 6;
        const above = r.top - h - 8;
        const top = r.bottom + h + 12 > window.innerHeight ? above : below;
        guess.style.top = Math.max(8, Math.min(top, window.innerHeight - h - 8)) + "px";
      });
    });

    document.getElementById("fw-guess-close")?.addEventListener("click", closeGuess);
    document.addEventListener("click", (event) => {
      if (guess && !guess.hidden && !guess.contains(event.target as Node)) closeGuess();
    });
    document.addEventListener("keydown", (event) => { if (event.key === "Escape") closeGuess(); });
    window.addEventListener("scroll", closeGuess, true);

    // Maya send button — confirms, then POSTs; reports the outcome inline.
    const sendBtn = document.getElementById("fw-send") as HTMLButtonElement | null;
    sendBtn?.addEventListener("click", async () => {
      if (!confirm("Maya will email the WIP/AR summary + pack link to the internal distribution (Lucinda / Chandler / Tabatha / Chris). Send now?")) return;
      sendBtn.disabled = true;
      const original = sendBtn.textContent;
      sendBtn.textContent = "Sending…";
      try {
        const resp = await fetch("/api/accounting/friday-wip/send", { method: "POST" });
        const result = await resp.json().catch(() => ({}));
        if (resp.ok) {
          sendBtn.textContent = "Sent ✓";
          alert("Sent to: " + (result.to ?? []).join(", "));
        } else {
          sendBtn.textContent = original;
          alert("Send failed: " + (result.error_description ?? result.error ?? resp.status));
        }
      } catch (err) {
        sendBtn.textContent = original;
        alert("Send failed: " + err);
      } finally {
        sendBtn.disabled = false;
        setTimeout(() => { if (sendBtn.textContent === "Sent ✓") sendBtn.textContent = original; }, 4000);
      }
    });
  </script>
</AppShell>
