---
import AppShell from "../../../layouts/AppShell.astro";
import { loadAgreementBuilderOverview } from "@lib/agreement-builder-overview";
import { loadPriceAgreementCoverage, coverageLabelKind } from "@lib/price-agreement-coverage";
import { CM_VENDORS } from "@lib/cm-vendor-roster";
import { createServerSupabaseClient } from "@lib/supabase.server";

// Agreement Gaps — the Alex queue (PEC-195): repeat-purchase No-Price items per
// (vendor, PE office), candidates for the GLOBAL PRODUCT FILE — the base standard
// for all negotiated price lists. Populated nightly by alex_no_price_triage().
interface GapRow { vendor_slug: string; office: string; item_number: string; item_description: string | null; purchases_ytd: number; spend_ytd: number | null; last_purchase: string | null; }
let gapRows: GapRow[] = [];
{
  const { client } = createServerSupabaseClient();
  if (client) {
    for (let from = 0; ; from += 1000) {
      const { data } = await client
        .from("agreement_gap_queue")
        .select("vendor_slug, office, item_number, item_description, purchases_ytd, spend_ytd, last_purchase")
        .eq("status", "candidate")
        .order("vendor_slug").order("office").order("spend_ytd", { ascending: false })
        .range(from, from + 999);
      gapRows.push(...(((data as any[] | null) ?? []) as GapRow[]));
      if (!data || data.length < 1000) break;
    }
  }
}
const gapGroups = new Map<string, GapRow[]>();
for (const r of gapRows) {
  const k = `${r.vendor_slug} · ${r.office}`;
  (gapGroups.get(k) ?? (gapGroups.set(k, []), gapGroups.get(k)!)).push(r);
}

// Each loader degrades to its own empty shape rather than 500-ing the page: the cost
// roll-up reads v_negotiable_items, which intermittently exceeds the statement timeout,
// and that should not take the territory-coverage section down with it (or vice versa).
const [overviewResult, coverageResult] = await Promise.allSettled([
  loadAgreementBuilderOverview(),
  loadPriceAgreementCoverage(),
]);
const loadErrors: string[] = [];
if (overviewResult.status === "rejected") loadErrors.push(`Cost roll-up unavailable: ${overviewResult.reason?.message ?? overviewResult.reason}`);
if (coverageResult.status === "rejected") loadErrors.push(`Territory coverage unavailable: ${coverageResult.reason?.message ?? coverageResult.reason}`);
const data = overviewResult.status === "fulfilled"
  ? overviewResult.value
  : { status: "unconfigured" as const, generatedAt: new Date().toISOString(), recipient: { name: "", email: "" }, offices: [], totals: { offices: 0, branches: 0, projectedCost: 0, historicalSpend: 0, savings: 0, negotiableItems: 0 } };
const coverage = coverageResult.status === "fulfilled"
  ? coverageResult.value
  : { status: "unconfigured" as const, generatedAt: new Date().toISOString(), offices: [], totals: { offices: 0, vendors: 0, branchRows: 0, primaryBranches: 0, regionCoveredBranches: 0, branchesInheriting: 0, pricedItems: 0, gaps: 0, lapsedVendors: 0, gapsWithSpend: 0, gapsToChase: 0, gapSpend: 0, chaseSpend: 0, unresolvedSpend: 0 } };
const milesLabel = (m: number | null) => (m == null ? "—" : `${m.toFixed(1)} mi`);
const generatedAt = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", hour: "numeric", minute: "2-digit" }).format(new Date(data.generatedAt));
const runtimeTone = data.status === "live" ? "ready" : "watch";
const runtimeLabel = data.status === "live" ? "Supabase live" : "Supabase pending";
const money = (n: number) => (n < 0 ? "-$" : "$") + Math.abs(Math.round(n)).toLocaleString("en-US");
const offices = data.offices.map((o) => o.office);

const payload = JSON.stringify({ offices: data.offices, recipient: data.recipient }).replace(/</g, "\\u003c");
---

<AppShell title="Agreement Builder" eyebrow="Accounting" activePage="accounting">
  <section class="iv" data-theme="light" data-pref="system">
    {loadErrors.length > 0 && (
      <div class="iv-load-warning" role="status">
        <strong>Partial data.</strong> {loadErrors.join(" ")} The rest of this page is still accurate.
      </div>
    )}
    <div class="iv-toolbar">
      <input class="iv-input" id="iv-search" type="search" placeholder="Search office, branch…" autocomplete="off" />
      <select class="iv-select" id="iv-office">
        <option value="">All PE offices</option>
        {offices.map((o) => <option value={o}>{o}</option>)}
      </select>
      <!-- Vendor strip (PEC-196): roster-driven, one seam (cm-vendor-roster agreementStatus).
           The builder worksheet below is ABC-only by construction today; other vendors
           surface honestly — read_only points at the multi-vendor Price Agreements page,
           coming_soon greys out. Adding vendor N+1 = one roster entry (docs/90). -->
      <div class="iv-vendor-strip" role="group" aria-label="Vendor">
        {CM_VENDORS.map((v) => {
          if (v.agreementStatus === "live")
            return <span class="iv-vbtn is-active" title={`${v.label} — full builder flow`}>{v.acronym}</span>;
          if (v.agreementStatus === "read_only")
            return <a class="iv-vbtn iv-vbtn-ro" href="/accounting/price-agreements" title={`${v.label} — coverage, worksheets and price lists live on Price Agreements; the builder send flow is ABC-only today (PEC-196)`}>{v.acronym} ↗</a>;
          return <span class="iv-vbtn iv-vendor-off" title="Coming Soon">{v.acronym}</span>;
        })}
      </div>
      <a class="iv-export" id="iv-methodology" href="/accounting/price-agreement/methodology" target="_blank" rel="noopener">📘 ABC classes</a>
      <span class="iv-spacer"></span>
      <span class="runtime-pill" data-tone={runtimeTone}><span class="signal-dot" aria-hidden="true"></span>{runtimeLabel}</span>
      <span class="iv-count">{generatedAt}</span>
      <div class="iv-theme" role="group" aria-label="Theme">
        <button type="button" data-set-theme="system" class="is-active">System</button>
        <button type="button" data-set-theme="light">Light</button>
        <button type="button" data-set-theme="dark">Dark</button>
      </div>
    </div>

    <div class="iv-kpis">
      <div class="iv-kpi"><span class="iv-kpi-lab">PE Offices</span><span class="iv-kpi-val">{data.totals.offices}</span><span class="iv-kpi-sub">{data.totals.branches} vendor branches buying A+B</span></div>
      <div class="iv-kpi"><span class="iv-kpi-lab">Negotiable Items</span><span class="iv-kpi-val">{data.totals.negotiableItems.toLocaleString()}</span><span class="iv-kpi-sub">ABC review-class A+B master</span></div>
      <div class="iv-kpi"><span class="iv-kpi-lab">36mo Spend</span><span class="iv-kpi-val">{money(data.totals.historicalSpend)}</span><span class="iv-kpi-sub">historical, on negotiable items</span></div>
      <div class="iv-kpi"><span class="iv-kpi-lab">Projected at Set Price</span><span class="iv-kpi-val">{money(data.totals.projectedCost)}</span><span class="iv-kpi-sub">negotiated / set prices × 36mo volume</span></div>
      <div class="iv-kpi"><span class="iv-kpi-lab">Projected Savings</span><span class="iv-kpi-val">{money(data.totals.savings)}</span><span class="iv-kpi-sub">vs historical spend</span></div>
    </div>

    <p class="iv-note">Negotiable worksheet across every PE office. Drill in: <b>PE Office → Vendor → Vendor/Branch → Category → Item → Variation</b>. Costs roll up from each branch's trailing-36mo volume at the <b>set price</b> (persisted proposal → branch negotiated price → historical average). Each variation prefills with the branch's latest negotiated price; set a price at the item level to cascade to its variations. Recipient on send = <b>{data.recipient.name}</b> ({data.recipient.email}) — but nothing sends from here: edits save as a <b>draft</b> for review.</p>

    {data.offices.length === 0 && <p class="iv-empty">No negotiable items found.</p>}
    <div id="iv-tree"></div>

    <h2 class="tc-head" id="agreement-gaps">Agreement Gaps — Alex Queue ({gapRows.length} candidates)</h2>
    <p class="iv-note">Items with <b>no negotiated price</b> purchased <b>2+ times this calendar year</b> for the same (vendor, PE office) — Alex auto-clears every other No-Price line nightly. These are the candidates for the <b>global product file</b>, the base standard for all negotiated price lists. Sorted by YTD spend.</p>
    {gapRows.length === 0 && <p class="iv-empty">No candidates — Alex has triaged every No-Price line.</p>}
    <div class="gap-groups">
      {[...gapGroups.entries()].map(([label, rows]) => (
        <details class="gap-group">
          <summary><b>{label}</b><span class="gap-tags"><span class="pill pill-brand">{rows.length} items</span><span class="pill pill-grey">${Math.round(rows.reduce((s, r) => s + Number(r.spend_ytd ?? 0), 0)).toLocaleString()} YTD</span></span></summary>
          <table class="gap-table">
            <thead><tr><th>Item</th><th>Description</th><th class="num">Purchases YTD</th><th class="num">Spend YTD</th><th>Last Purchase</th></tr></thead>
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td class="mono">{r.item_number}</td>
                  <td>{r.item_description}</td>
                  <td class="num">{r.purchases_ytd}</td>
                  <td class="num">${Number(r.spend_ytd ?? 0).toLocaleString("en-US", { minimumFractionDigits: 2 })}</td>
                  <td>{r.last_purchase ?? "—"}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </details>
      ))}
    </div>

    <h2 class="tc-head">Territory Coverage — who inherits which price list</h2>
    <p class="iv-note">A price agreement held by <b>any</b> branch inside a PE office's 2-hour drive-time ring is <b>inherited by every branch of that vendor in that ring</b>. Where two agreements compete, they resolve <b>per item — lowest price wins</b>, and the source branch is recorded. A lapsed list is <b>still in force</b> until the vendor replaces it, so it shows as <b>Extended (awaiting replacement)</b>, never as an error. A branch that sits inside two office rings is listed under <b>both</b> offices — that is intentional.</p>

    {coverage.offices.length === 0 && <p class="iv-empty">No territory coverage rows found.</p>}

    {coverage.totals.gaps > 0 && (
      <p class="iv-note">
        <b>{coverage.totals.gaps}</b> office × vendor pairs have no <b>reachable</b> agreement coverage. <b>{coverage.totals.gapsWithSpend}</b> carry
        spend; of those, <b>{coverage.totals.gapsToChase}</b> are actually work — <b>{money(coverage.totals.chaseSpend)}</b>
        of invoiced spend sitting on pairs that cannot be audited and carry no ruling accepting that. <b>Not all of it is
        missing paperwork</b> — where a pair shows &ldquo;ring can't reach it&rdquo;, a live agreement already
        exists and the fix is to repair the agreement-to-branch link, not to chase a new one. The rest are either territory-only
        (branches in the ring, nothing purchased yet) or carry an accepted <code>no_book</code> ruling, which prices
        as no-price by design and is not something to chase.
        <br />
        <small>Figures are invoice <b>totals</b>, which include tax, freight, and lines the line-level path does price —
        they are not the un-audited amount, and they are net of any credit memos posted against the pair. The genuinely
        unpriced line value is always lower, and is measured on the line-level path rather than shown here.</small>
      </p>
    )}

    {coverage.totals.unresolvedSpend !== 0 && (
      <p class="iv-note">
        <b>{money(coverage.totals.unresolvedSpend)}</b> sits on branches with <b>no pricing territory</b>, so it is
        outside this audit entirely. Shown independently of the gap count — it is still true when every
        office × vendor pair is covered.
      </p>
    )}

    {coverage.offices.map((office) => (
      <details class="iv-office">
        <summary>
          <span class="iv-chev">›</span>
          <span class="iv-office-name">{office.officeName}{office.officeState ? ` · ${office.officeState}` : ""}</span>
          <div class="iv-mini">
            <div><strong>{office.vendors.length}</strong><span>Vendors</span></div>
            <div><strong>{office.vendors.reduce((s, v) => s + v.branchesInTerritory, 0)}</strong><span>In territory</span></div>
            <div><strong>{office.vendors.reduce((s, v) => s + v.primaryBranches + v.regionCoveredBranches, 0)}</strong><span>Hold agreement</span></div>
            <div><strong>{office.vendors.reduce((s, v) => s + v.pricedItems, 0).toLocaleString()}</strong><span>Priced items</span></div>
          </div>
        </summary>
        <div class="iv-office-body">
          {office.vendors.map((vendor) => (
            <details class="iv-vendor">
              <summary>
                <span class="iv-chev">›</span>
                <span class="iv-vendor-name">{vendor.vendorName}</span>
                <div class="iv-mini">
                  <div><strong>{vendor.branchesInTerritory}</strong><span>In territory</span></div>
                  <div><strong>{vendor.primaryBranches}</strong><span>Primary</span></div>
                  <div><strong>{vendor.branchesInheriting}</strong><span>Inheriting</span></div>
                  <div><strong>{vendor.pricedItems.toLocaleString()}</strong><span>Priced items</span></div>
                </div>
                <div class="iv-branch-tags">
                  {/* Order is decided by coverageLabelKind() — see its doc comment. Do not
                      reorder these branches here; change the function and its tests. */}
                  {coverageLabelKind(vendor) === "accepted"
                    ? <span class="pill pill-grey">Accepted ruling ({vendor.agreementStatus}) — {money(vendor.spend)} spend, not work</span>
                    : coverageLabelKind(vendor) === "unreachable"
                      ? <span class="pill pill-red">Agreement exists, ring can't reach it — {money(vendor.spend)} spend ({vendor.invoiceCount} inv). Repair the branch link, don't chase paperwork.</span>
                      : coverageLabelKind(vendor) === "no-spend"
                        ? <span class="pill pill-grey">No agreement — no spend yet</span>
                        : coverageLabelKind(vendor) === "no-agreement"
                          ? <span class="pill pill-red">No agreement — {money(vendor.spend)} spend ({vendor.invoiceCount} inv)</span>
                          : null}
                  {vendor.anyLapsed && <span class="pill pill-yellow">Extended (awaiting replacement)</span>}
                  {vendor.competingAgreements > 1 && <span class="pill pill-brand">{vendor.competingAgreements} competing lists — lowest price per item</span>}
                </div>
              </summary>
              <div class="iv-vendor-body">
                <div class="iv-actions">
                  <span class="iv-actions-id">{vendor.vendorSlug}</span>
                  <a class="iv-export" href={`/api/price-agreement/coverage-export?vendor=${encodeURIComponent(vendor.vendorSlug)}&format=pdf`}>⬇ Export PDF</a>
                  <a class="iv-export" href={`/api/price-agreement/coverage-export?vendor=${encodeURIComponent(vendor.vendorSlug)}&format=csv`}>⬇ Export CSV</a>
                </div>
                {vendor.branches.length === 0 ? (
                  <p class="iv-loading">No branches mapped into this office ring.</p>
                ) : (
                  <table class="iv-table">
                    <thead>
                      <tr>
                        <th>Branch #</th>
                        <th>Branch</th>
                        <th>City / State</th>
                        <th class="num">Miles</th>
                        <th>Phone</th>
                        <th>Coverage</th>
                      </tr>
                    </thead>
                    <tbody>
                      {vendor.branches.map((branch) => (
                        <tr class={branch.role === "Inherits" ? "" : "tc-holder"}>
                          <td class="iv-sku">{branch.branchNumber || "—"}</td>
                          <td>{branch.branchName || "—"}</td>
                          <td>{[branch.city, branch.state].filter(Boolean).join(", ") || "—"}</td>
                          <td class="num">{milesLabel(branch.milesFromOffice)}</td>
                          <td>{branch.phone || "—"}</td>
                          <td>
                            {branch.role === "Primary" && <span class="pill pill-brand">Primary — holds agreement</span>}
                            {branch.role === "Region-covered" && <span class="pill pill-green">Region agreement</span>}
                            {branch.role === "Inherits" && <span class="pill pill-grey">Inherits ring price list</span>}
                            {branch.holdsAgreement && (
                              <span class="tc-agree">
                                {branch.agreementNumber ?? "no agreement #"}
                                {branch.effectiveDate ? ` · eff. ${branch.effectiveDate}` : ""}
                                {branch.isLapsed ? " · Extended (awaiting replacement)" : ""}
                              </span>
                            )}
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )}
              </div>
            </details>
          ))}
        </div>
      </details>
    ))}
  </section>

  <script type="application/json" id="iv-data" set:html={payload}></script>
  <div class="ia-toast" id="iv-toast" role="status" aria-live="polite"></div>
  <canvas id="iv-confetti" hidden></canvas>
</AppShell>

<style is:global>
  /* Agreement Gaps queue (PEC-195) */
  .iv .gap-groups{margin:0 0 26px}
  .iv .gap-group{border:1px solid var(--line);border-radius:10px;margin:8px 0;background:var(--panel)}
  .iv .gap-group>summary{display:flex;align-items:center;gap:10px;padding:10px 13px;cursor:pointer;list-style:none}
  .iv .gap-group>summary::-webkit-details-marker{display:none}
  .iv .gap-tags{margin-left:auto;display:flex;gap:6px}
  .iv .gap-table{width:100%;border-collapse:collapse;border-top:1px solid var(--line)}
  .iv .gap-table th{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted);text-align:left;padding:8px 12px;background:var(--panel2)}
  .iv .gap-table td{padding:7px 12px;border-top:1px solid var(--line);font-size:12.5px}
  .iv .gap-table .num{text-align:right;font-variant-numeric:tabular-nums}
  .iv .gap-table .mono{font-family:ui-monospace,Menlo,monospace;font-size:12px}
  /* Vendor strip (PEC-196) — greyed buttons keep pointer events so tooltips work. */
  .iv .iv-vendor-strip{display:inline-flex;gap:6px;align-items:center}
  .iv .iv-vbtn{display:inline-block;padding:6px 12px;border-radius:8px;border:1px solid var(--line);background:var(--panel);color:var(--muted);font-size:12px;font-weight:700;text-decoration:none}
  .iv .iv-vbtn.is-active{background:var(--brand);border-color:var(--brand);color:#fff}
  .iv .iv-vbtn-ro{color:var(--brand)}
  .iv .iv-vbtn.iv-vendor-off{opacity:.45;filter:grayscale(.35);cursor:not-allowed}
  .iv .iv-load-warning{margin:0 0 12px;padding:10px 13px;border-radius:8px;background:var(--yellow-bg);border:1px solid var(--yellow);color:var(--yellow);font-size:13px}
  .iv .iv-load-warning strong{color:var(--ink)}
  .iv{
    --bg:#f4f6f9; --panel:#ffffff; --panel2:#f7f8fb; --ink:#1c2733; --muted:#6b7886; --line:#e3e8ef;
    --brand:#5b46d8; --brand-bg:#efecfd; --green:#137a4d; --green-bg:#e3f5ec; --yellow:#946400; --yellow-bg:#fbf0d4;
    --orange:#a4480d; --orange-bg:#fbe7d6; --red:#a51f1f; --red-bg:#fbe2e2; --grey:#5a6573; --grey-bg:#eceff4; --shadow:0 6px 18px rgba(20,28,40,.08);
    background:var(--bg); color:var(--ink);
    margin:calc(-1 * var(--space-4, 16px)) calc(-1 * var(--gutter, 24px)) calc(-1 * var(--space-6, 24px));
    padding:18px var(--gutter, 24px) 30px; min-height:70vh; font-family:var(--font-sans, Inter, system-ui, sans-serif);
  }
  .iv[data-theme="dark"]{
    --bg:#0f141b; --panel:#161d27; --panel2:#1c2530; --ink:#e6edf5; --muted:#8b98a8; --line:#27313e;
    --brand:#8a7bff; --brand-bg:#21243f; --green:#7ee2ad; --green-bg:#123626; --yellow:#f2cf6b; --yellow-bg:#3a3115;
    --orange:#f3a766; --orange-bg:#3d2913; --red:#ff8585; --red-bg:#3d1a1a; --grey:#9aa6b4; --grey-bg:#222c38; --shadow:0 6px 18px rgba(0,0,0,.4);
  }
  .iv .pill{display:inline-block;padding:2px 9px;border-radius:999px;font-size:11px;font-weight:600;white-space:nowrap;line-height:1.5}
  .iv .pill-green{background:var(--green-bg);color:var(--green)}
  .iv .pill-yellow{background:var(--yellow-bg);color:var(--yellow)}
  .iv .pill-red{background:var(--red-bg);color:var(--red)}
  .iv .pill-grey{background:var(--grey-bg);color:var(--grey)}
  .iv .pill-brand{background:var(--brand-bg);color:var(--brand)}

  .iv-toolbar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:16px}
  .iv-input,.iv-select{background:var(--panel);border:1px solid var(--line);color:var(--ink);border-radius:8px;padding:8px 11px;font-size:13px;font-family:inherit}
  .iv-input{min-width:220px}
  .iv-spacer{flex:1}
  .iv-count{font-size:12px;color:var(--muted)}
  .iv-empty{color:var(--muted);font-size:13px;padding:14px 4px}
  .iv-note{color:var(--muted);font-size:12px;line-height:1.5;margin:0 0 16px;max-width:1040px}
  .iv-note b{color:var(--ink)}
  .iv-theme{display:inline-flex;border:1px solid var(--line);border-radius:9px;overflow:hidden;background:var(--panel)}
  .iv-theme button{appearance:none;border:none;background:transparent;color:var(--muted);font-size:12px;font-weight:600;padding:7px 12px;cursor:pointer;font-family:inherit}
  .iv-theme button.is-active{background:var(--brand);color:#fff}
  .iv-export{border:1px solid var(--line);border-radius:8px;padding:6px 10px;font-size:12px;font-weight:650;color:var(--brand);text-decoration:none;background:var(--panel);white-space:nowrap;cursor:pointer;font-family:inherit}
  .iv-export:hover{border-color:var(--brand);background:var(--brand-bg)}
  .iv-export.primary{background:var(--brand);color:#fff;border-color:var(--brand)}
  .iv-export.primary:hover{filter:brightness(.95);background:var(--brand)}
  .iv-export:disabled{opacity:.5;cursor:default}

  .iv-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:12px;margin-bottom:18px}
  .iv-kpi{display:flex;flex-direction:column;gap:3px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:13px 15px}
  .iv-kpi-lab{font-size:11px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);font-weight:600}
  .iv-kpi-val{font-size:22px;font-weight:750;font-variant-numeric:tabular-nums}
  .iv-kpi-sub{font-size:11px;color:var(--muted)}

  /* Office / Vendor / Branch tree */
  .iv-office{background:var(--panel);border:1px solid var(--line);border-radius:14px;margin-bottom:12px;overflow:hidden}
  .iv-office>summary{display:flex;align-items:center;gap:14px;padding:14px 16px;cursor:pointer;list-style:none}
  .iv-office>summary::-webkit-details-marker{display:none}
  .iv-chev{color:var(--muted);transition:transform .15s;font-size:15px}
  details[open]>summary .iv-chev{transform:rotate(90deg)}
  .iv-office-name{font-weight:750;font-size:15px;flex:1}
  .iv-mini{display:flex;gap:16px}
  .iv-mini div{text-align:center}
  .iv-mini strong{display:block;font-size:14px;font-weight:750;font-variant-numeric:tabular-nums}
  .iv-mini span{font-size:10px;text-transform:uppercase;letter-spacing:.03em;color:var(--muted)}
  .iv-office-body{padding:4px 12px 12px;border-top:1px solid var(--line)}

  .iv-vendor{border:1px solid var(--line);border-radius:11px;margin:10px 0;background:var(--panel2)}
  .iv-vendor>summary{display:flex;align-items:center;gap:12px;padding:10px 13px;cursor:pointer;list-style:none}
  .iv-vendor>summary::-webkit-details-marker{display:none}
  .iv-vendor-name{font-weight:700;font-size:13.5px;flex:1}
  .iv-vendor-body{padding:2px 10px 10px}

  .iv-branch{border:1px solid var(--line);border-radius:10px;margin:8px 0;background:var(--panel)}
  .iv-branch>summary{display:flex;align-items:center;gap:12px;padding:10px 12px;cursor:pointer;list-style:none;flex-wrap:wrap}
  .iv-branch>summary::-webkit-details-marker{display:none}
