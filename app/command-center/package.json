{
  "name": "@open-brain/command-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro build",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node runtime/start-command-center.mjs",
    "start:web": "node dist/server/entry.mjs",
    "slack:runtime": "node --import ./runtime/sentry-instrument.mjs runtime/slack-socket-runtime.mjs",
    "price-agreements:audit": "node scripts/audit-price-agreement-items.mjs",
    "price-agreements:audit:active": "node scripts/audit-price-agreement-items.mjs --active-only",
    "price-agreements:audit:fail": "node scripts/audit-price-agreement-items.mjs --fail-on-gaps",
    "vendor:reconcile": "node scripts/reconcile-vendor-branches.mjs",
    "vendor:reconcile:write": "node scripts/reconcile-vendor-branches.mjs --write",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "perf:warm": "node scripts/warm-command-center.mjs",
    "perf:cadence": "node scripts/cadence-command-center.mjs",
    "pec78:db-integration": "node scripts/pec78-db-integration.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.5",
    "@astrojs/react": "6.0.5",
    "@proexteriors/contracts": "file:vendor/proexteriors-contracts-0.1.17.tgz",
    "@proexteriors/crm-server": "file:vendor/proexteriors-crm-server-0.1.17.tgz",
    "@proexteriors/design-system": "file:vendor/proexteriors-design-system-0.1.0.tgz",
    "@proexteriors/sales-workspace": "file:vendor/proexteriors-sales-workspace-0.1.30.tgz",
    "@sentry/astro": "10.73.0",
    "@sentry/node": "10.73.0",
    "@slack/bolt": "^4.7.3",
    "@supabase/supabase-js": "^2.107.0",
    "@workos-inc/node": "^10.2.0",
    "astro": "7.3.1",
    "chart.js": "4.5.1",
    "exceljs": "^4.4.0",
    "pdf-lib": "^1.17.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "^2.17.5",
    "svix": "^1.95.1"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "postgres": "^3.4.7",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "exceljs": {
      "uuid": "11.1.1"
    }
  }
}
