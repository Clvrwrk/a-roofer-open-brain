{
  "name": "quickbooks-bridge",
  "display_name": "QuickBooks Online",
  "version": "1.0.0",
  "tier": 1,
  "source_system_type": "saas-with-api",
  "enabled": true,
  "origin": "cleverwork",
  "access_mode": "read_only",
  "write_enabled": false,
  "mirror": {
    "destination": "supabase",
    "schema_migration": "188-qbo-mirror-ddl.sql",
    "register_views_migration": "189-qbo-register-views.sql",
    "register_schema": "qbo_registers",
    "job": "mirror-backfill.mjs",
    "thursday_script": "scripts/qbo-thursday-sync.sh",
    "docs": "docs/76-qbo-supabase-mirror.md",
    "linear": ["PEC-102", "PEC-109"]
  },
  "bound_agents": ["capture", "conductor", "accounting"],
  "env_vars": {
    "required": [
      "QUICKBOOKS_CLIENT_ID",
      "QUICKBOOKS_CLIENT_SECRET",
      "QUICKBOOKS_REFRESH_TOKEN",
      "QUICKBOOKS_REALM_ID"
    ],
    "optional": [
      "QUICKBOOKS_SANDBOX_MODE",
      "QUICKBOOKS_ACCESS_MODE",
      "QUICKBOOKS_WRITE_ENABLED",
      "QUICKBOOKS_ENV",
      "QUICKBOOKS_APP_ID"
    ]
  },
  "webhook_topics": ["Invoice", "Payment", "Bill", "VendorCredit"],
  "objects_ingested": [
    "company_info",
    "accounts",
    "customers",
    "vendors",
    "classes",
    "invoices",
    "payments",
    "bills",
    "bill_payments",
    "purchases",
    "deposits",
    "journal_entries",
    "vendor_credits",
    "credit_memos",
    "transfers",
    "report_snapshots"
  ],
  "debrief_trigger_milestone": null,
  "edition": "online",
  "notes": "QBO only. QuickBooks Desktop is a separate Tier 3 adapter. Token refresh job required — refresh_token expires in 100 days. Set QUICKBOOKS_SANDBOX_MODE=true for non-production testing. PRODUCTION IS READ-ONLY / MIRROR-ONLY (PEC-98 / docs/74): QUICKBOOKS_ACCESS_MODE=read_only and QUICKBOOKS_WRITE_ENABLED=false. Use read-only-client.mjs for all agent/sync pulls."
}
