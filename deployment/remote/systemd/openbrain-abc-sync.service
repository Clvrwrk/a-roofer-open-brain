[Unit]
Description=Open Brain nightly ABC Supply sync (cycle-count + daily invoice ingest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Repo clone + root .env live on the agent host (docs/27 host B).
ExecStart=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/abc-nightly-sync.sh
User=root
# systemd starts oneshots with no HOME; the wrappers (set -u) and the master.env loader need it (docs/109 D8).
Environment=HOME=/root
# Report the result to the runtime board on success AND failure (docs/109 D7/D12, mig 286).
ExecStopPost=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/runtime-job-report.sh systemd.openbrain-abc-sync
# The sync + invoice ingest can take a while on slow nights; hard stop at 2h.
TimeoutStartSec=7200
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
