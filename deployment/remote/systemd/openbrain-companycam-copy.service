[Unit]
Description=Open Brain CompanyCam photo copy — drains the companycam-photos queue, open jobs first (docs/120)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/companycam-sync.sh copy
User=root
Environment=HOME=/root
ExecStopPost=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/runtime-job-report.sh systemd.openbrain-companycam-copy
# The timer fires every 30 min; a tick never overlaps the next (oneshot). The runner's claim
# budgets (photos 15 min, videos 3 min) plus per-request timeouts finish the tick before this
# deadline; claims left by a killed run return to the queue after 30 min (release_stale_*).
TimeoutStartSec=1790
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
