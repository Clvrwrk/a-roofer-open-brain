[Unit]
Description=Maya nightly QA of cc.proexteriorsus.net (wide walk + chaos forensic pass)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Env sourced by the wrapper, not systemd: the repo .env carries quoted/multi-line
# values EnvironmentFile cannot parse. Same pattern as maya-gate.sh and site-sweep.sh.
WorkingDirectory=/opt/openbrain/a-roofers-open-brain
ExecStart=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/maya-qa.sh
User=root
# systemd starts oneshots with no HOME; the wrappers and the master.env loader need it (docs/109 D8).
Environment=HOME=/root
# Report the result to the runtime board on success AND failure (docs/109 D7/D12, mig 286).
# SuccessExitStatus below means a reporting exit 1 is recorded as success with exit_code 1 (board: yellow).
ExecStopPost=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/runtime-job-report.sh systemd.openbrain-maya-qa
# Two passes, each polled up to 30 min, plus slack. 80 min is generous but bounded.
TimeoutStartSec=4800
StandardOutput=journal
StandardError=journal
# A failing QA run reports; it must not wedge the timer.
SuccessExitStatus=0 1

[Install]
WantedBy=multi-user.target
