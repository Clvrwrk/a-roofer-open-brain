[Unit]
Description=Maya diagnose -> Slack-approved repair gate pass (A3; PEC intakes -> #pe-cc-dev-team)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/maya-gate.sh run
User=root
# systemd starts oneshots with no HOME; the wrappers and the master.env loader need it (docs/109 D8).
Environment=HOME=/root
# Report the result to the runtime board on success AND failure (docs/109 D7/D12, mig 286).
ExecStopPost=/usr/bin/env bash /opt/openbrain/a-roofers-open-brain/scripts/runtime-job-report.sh systemd.openbrain-maya-gate
TimeoutStartSec=900
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
