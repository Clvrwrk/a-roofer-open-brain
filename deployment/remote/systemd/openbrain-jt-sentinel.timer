[Unit]
# Retired by Chris 2026-10-23; retained only for historical reference.
ConditionPathExists=/nonexistent/jobtread-retired-by-chris-2026-10-23
Description=Daily JobTread Sync Sentinel at 10:00 America/Los_Angeles (DST-aware)

[Timer]
OnCalendar=*-*-* 10:00:00 America/Los_Angeles
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
